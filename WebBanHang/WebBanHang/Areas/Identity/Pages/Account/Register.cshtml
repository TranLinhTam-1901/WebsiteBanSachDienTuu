@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="min-vh-100 d-flex align-items-center bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-12">
                <div class="card shadow border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-primary mb-2">📚 3T-Books</h2>
                            <p class="text-muted">Tạo tài khoản mới để bắt đầu hành trình đọc sách của bạn</p>
                        </div>

                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.FullName" class="form-control" placeholder="Họ và tên" required />
                                        <label asp-for="Input.FullName">Họ và tên</label>
                                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.Email" class="form-control" type="email" placeholder="Email" required />
                                        <label asp-for="Input.Email">Email</label>
                                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.PhoneNumber" class="form-control" type="tel" placeholder="Số điện thoại" required />
                                        <label asp-for="Input.PhoneNumber">Số điện thoại</label>
                                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.Age" class="form-control" type="number" min="10" max="120" placeholder="Tuổi" />
                                        <label asp-for="Input.Age">Tuổi</label>
                                        <span asp-validation-for="Input.Age" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Input.Address" class="form-control" placeholder="Địa chỉ" />
                                        <label asp-for="Input.Address">Địa chỉ</label>
                                        <span asp-validation-for="Input.Address" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.Password" class="form-control" type="password" placeholder="Mật khẩu" required />
                                        <label asp-for="Input.Password">Mật khẩu</label>
                                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Xác nhận mật khẩu" required />
                                        <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" asp-for="Input.Role" value="User" />

                            <div class="mt-4">
                                <button id="registerSubmit" type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                                    Đăng ký
                                </button>
                            </div>

                            <div class="text-center mt-3">
                                <p class="text-muted small mb-0">
                                    Đã có tài khoản?
                                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">Đăng nhập</a>
                                </p>
                            </div>
                        </form>
                        <div class="text-center text-muted small mt-4">
                            © 2025 3T-Books. All rights reserved.
                        </div>

                        @* <div class="mt-4"> *@
                            @* <div class="d-flex align-items-center gap-3 mb-3">
                                <hr class="flex-grow-1 m-0" />
                                <span class="text-muted small">Hoặc đăng ký bằng</span>
                                <hr class="flex-grow-1 m-0" />
                            </div> *@
                            @* <div class="text-center">
                                @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                                {
                                    <div class="alert alert-light text-center m-0 small">Chưa cấu hình mạng xã hội.</div>
                                }
                                else
                                {
                                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-outline-dark rounded-pill me-2 mb-2" name="provider" value="@provider.Name">
                                                <i class="bi bi-person-circle me-1"></i>@provider.DisplayName
                                            </button>
                                        }
                                    </form>
                                }
                            </div> *@
                        @* </div> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    <style >
    /* 🌈 Nền tổng thể */
    body {
        background: linear-gradient(135deg, #f9fafb, #eef2f7);
        font-family: "Segoe UI", Roboto, sans-serif;
    }

    /* Card chứa form */
    .card {
        border-radius: 1rem;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

    /* Tiêu đề */
    h2, .fw-bold.text-primary {
        color: #375cd3 !important;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    p.text-muted {
        color: #6c757d !important;
        font-size: 0.95rem;
    }

    /* Label floating input */
    .form-floating > label {
        color: #6c757d;
        font-size: 0.95rem;
    }

    /* Ô input */
    .form-control {
        border-radius: 0.6rem;
        border: 1px solid #d0d7de;
        box-shadow: none;
        transition: all 0.25s ease;
    }

        .form-control:focus {
            border-color: #4e73df;
            box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.2);
        }

    /* Nút đăng ký */
    .btn-primary {
        background: linear-gradient(90deg, #4e73df, #375cd3);
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #3b5bdb, #2f49c5);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(59, 91, 219, 0.35);
        }

        .btn-primary:active {
            transform: scale(0.97);
            box-shadow: 0 3px 10px rgba(59, 91, 219, 0.3);
        }

    /* Liên kết (Đăng nhập, mạng xã hội) */
    a {
        color: #3b5bdb;
        text-decoration: none;
        transition: color 0.2s ease;
    }

        a:hover {
            color: #1d3fdc;
            text-decoration: underline;
        }

    /* Divider “hoặc đăng ký bằng” */
    hr.flex-grow-1 {
        opacity: 0.25;
    }

    /* Nút mạng xã hội */
    .btn-outline-dark {
        border-radius: 2rem;
        transition: all 0.2s ease;
    }

        .btn-outline-dark:hover {
            background-color: #3b5bdb;
            color: #fff;
            border-color: #3b5bdb;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 91, 219, 0.25);
        }

    /* Khoảng cách trong form */
    .card-body {
        padding: 2rem 2.5rem;
    }

    /* Khi focus trong form — đổ bóng nhẹ */
    form:focus-within .card {
        box-shadow: 0 10px 30px rgba(78, 115, 223, 0.15);
    }

    /* Nút và input khi disabled */
    .btn:disabled, .form-control:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }
</style>

</style>
