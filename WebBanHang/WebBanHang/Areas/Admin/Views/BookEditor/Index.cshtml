@{
    ViewData["Title"] = "Công cụ soạn sách";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">📚 Công cụ soạn sách</h2>
            <p class="text-muted mb-0">Viết, chia chương và xuất sách dễ dàng</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="saveDraft()">
                💾 Lưu nháp
            </button>
            <button type="button" class="btn btn-outline-info" onclick="loadDraft()">
                📂 Tải nháp
            </button>
            <button type="button" class="btn btn-success" onclick="applyToProduct()">
                ✅ Áp dụng vào sản phẩm
            </button>
        </div>
    </div>

    <!-- Main Editor Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4 bg-light">
            <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-info-circle"></i>
                <small>Viết từng chương riêng lẻ. Sau khi hoàn thành, nhấn "Áp dụng vào sản phẩm" để sử dụng.</small>
            </div>
            
            <!-- Tabs -->
            <ul class="nav nav-tabs mb-3" id="bookEditorTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="chapter-tab" data-bs-toggle="tab" data-bs-target="#chapter" type="button" role="tab">
                        ➕ Thêm chương mới
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="chapters-tab" data-bs-toggle="tab" data-bs-target="#chapters" type="button" role="tab">
                        📑 Danh sách chương (<span id="chapterCount">0</span>)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="preview-tab" data-bs-toggle="tab" data-bs-target="#preview" type="button" role="tab">
                        👁️ Xem trước PDF
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="bookEditorTabsContent">
                <!-- Tab 1: Add New Chapter -->
                <div class="tab-pane fade show active" id="chapter" role="tabpanel">
                    <div class="bg-white border rounded p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">📝 <span id="chapterFormTitle">Thêm chương mới</span></h6>
                            <small class="text-muted">Bạn đã có <strong><span id="tempChapterCount">0</span></strong> chương</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Tiêu đề chương</label>
                            <input type="text" id="chapterTitle" class="form-control shadow-sm" placeholder="Ví dụ: Chương 1 - Giới thiệu" />
                            <small class="text-muted">Nhập tiêu đề chương (không bắt buộc)</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Nội dung chương</label>
                            <textarea id="chapterContent" rows="15" class="form-control shadow-sm font-monospace" 
                                    placeholder="Viết nội dung chương ở đây..."></textarea>
                            <small class="text-muted d-flex justify-content-between mt-1">
                                <span>Nhập nội dung chương</span>
                                <span id="charCount">0 ký tự</span>
                            </small>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-success" onclick="addChapter()">
                                ✅ Lưu chương
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="clearChapterForm()">
                                🗑️ Xóa
                            </button>
                            <button type="button" class="btn btn-info" onclick="goToChaptersList()">
                                📑 Xem tất cả chương
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tab 2: Chapters List -->
                <div class="tab-pane fade" id="chapters" role="tabpanel">
                    <div id="chaptersList" class="border rounded p-3 bg-light">
                        <p class="text-muted text-center mb-0">Chưa có chương nào. Hãy thêm chương mới</p>
                    </div>
                </div>

                <!-- Tab 3: PDF Preview -->
                <div class="tab-pane fade" id="preview" role="tabpanel">
                    <div class="bg-white border rounded p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">👁️ Xem trước PDF</h6>
                            <button type="button" class="btn btn-danger" onclick="generatePDF()">
                                📄 Tải file PDF
                            </button>
                        </div>
                        <div id="pdfPreview" class="border p-4 bg-white" style="min-height: 600px;">
                            <p class="text-muted text-center">Chưa có nội dung để xem trước</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        // Book Chapter Splitter
        let chapters = [];
        let editingChapterIndex = null;

        // Đếm ký tự trong nội dung chương
        document.getElementById('chapterContent')?.addEventListener('input', function() {
            const charCount = this.value.length;
            document.getElementById('charCount').textContent = `${charCount.toLocaleString()} ký tự`;
        });

        // Hàm thêm chương mới
        function addChapter() {
            const title = document.getElementById('chapterTitle').value.trim();
            const content = document.getElementById('chapterContent').value.trim();

            if (!content) {
                alert('Vui lòng nhập nội dung chương!');
                return;
            }

            const chapter = {
                title: title || `Chương ${chapters.length + 1}`,
                content: content
            };

            if (editingChapterIndex !== null) {
                chapters[editingChapterIndex] = chapter;
                editingChapterIndex = null;
                
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.success('Đã cập nhật chương!', 'Thành công');
                }
            } else {
                chapters.push(chapter);
                
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.success(`Đã thêm chương ${chapters.length}!`, 'Thành công');
                }
            }

            clearChapterForm();
            displayChapters();
            updateChapterCount();
            goToChaptersList();
        }

        function clearChapterForm() {
            document.getElementById('chapterTitle').value = '';
            document.getElementById('chapterContent').value = '';
            document.getElementById('charCount').textContent = '0 ký tự';
            editingChapterIndex = null;
            document.getElementById('chapterFormTitle').textContent = 'Thêm chương mới';
        }

        function goToChaptersList() {
            if (chapters.length === 0) {
                alert('Chưa có chương nào!');
                return;
            }
            const chaptersTab = new bootstrap.Tab(document.getElementById('chapters-tab'));
            chaptersTab.show();
        }

        function editChapter(index) {
            const chapter = chapters[index];
            document.getElementById('chapterTitle').value = chapter.title;
            document.getElementById('chapterContent').value = chapter.content;
            
            const charCount = chapter.content.length;
            document.getElementById('charCount').textContent = `${charCount.toLocaleString()} ký tự`;
            
            editingChapterIndex = index;
            document.getElementById('chapterFormTitle').textContent = `Sửa chương ${index + 1}`;
            
            const chapterTab = new bootstrap.Tab(document.getElementById('chapter-tab'));
            chapterTab.show();
        }

        function deleteChapter(index) {
            if (confirm(`Bạn có chắc chắn muốn xóa "${chapters[index].title}" không?`)) {
                chapters.splice(index, 1);
                displayChapters();
                updateChapterCount();
                
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.success('Đã xóa chương!', 'Thành công');
                }
            }
        }

        function updateChapterCount() {
            document.getElementById('chapterCount').textContent = chapters.length;
            document.getElementById('tempChapterCount').textContent = chapters.length;
        }

        function displayChapters() {
            const container = document.getElementById('chaptersList');
            
            if (chapters.length === 0) {
                container.innerHTML = '<p class="text-muted text-center mb-0">Chưa có chương nào.</p>';
                return;
            }

            let html = '<div class="table-responsive"><table class="table table-hover">';
            html += '<thead><tr><th style="width:50px;">#</th><th>Tiêu đề chương</th><th style="width:100px;">Ký tự</th><th style="width:80px;">Dòng</th><th style="width:180px;">Thao tác</th></tr></thead>';
            html += '<tbody>';

            chapters.forEach((chapter, index) => {
                const lines = chapter.content.split('\n').length;
                const chars = chapter.content.length;
                const badgeColor = index % 2 === 0 ? 'bg-primary' : 'bg-success';
                
                html += `
                    <tr>
                        <td><span class="badge ${badgeColor}">${index + 1}</span></td>
                        <td onclick="showChapterModal(${index})" style="cursor:pointer;">${chapter.title}</td>
                        <td class="text-muted small">${chars.toLocaleString()}</td>
                        <td class="text-muted small">${lines}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-warning" onclick="editChapter(${index})">
                                ✏️
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteChapter(${index})">
                                🗑️
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info" onclick="showChapterModal(${index})">
                                👁️
                            </button>
                        </td>
                    </tr>
                `;
            });

            html += '</tbody></table></div>';
            
            html += `
                <div class="mt-3 text-center">
                    <button type="button" class="btn btn-success" onclick="exportToText()">
                        💾 Xuất file TXT
                    </button>
                    <button type="button" class="btn btn-info" onclick="copyToClipboard()">
                        📋 Sao chép
                    </button>
                    <button type="button" class="btn btn-primary" onclick="showPDFPreview()">
                        👁️ Xem trước PDF
                    </button>
                </div>
            `;

            container.innerHTML = html;
        }

        function showChapterModal(index) {
            const chapter = chapters[index];
            const modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.innerHTML = `
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">${chapter.title}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <pre style="white-space: pre-wrap; font-family: inherit;">${chapter.content}</pre>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            <button type="button" class="btn btn-primary" onclick="copyChapterToClipboard(${index})">Sao chép</button>
                        </div>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
            
            modal.addEventListener('hidden.bs.modal', () => modal.remove());
        }

        function exportToText() {
            if (chapters.length === 0) {
                alert('Chưa có chương nào để xuất!');
                return;
            }

            let content = '';
            chapters.forEach((chapter, index) => {
                content += `\n\n${'='.repeat(60)}\n`;
                content += `CHƯƠNG ${index + 1}: ${chapter.title}\n`;
                content += `${'='.repeat(60)}\n\n`;
                content += chapter.content;
            });

            const blob = new Blob([content], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'noi_dung_sach.txt';
            a.click();
            URL.revokeObjectURL(url);

            if (typeof NotificationSystem !== 'undefined') {
                NotificationSystem.success('Đã xuất file thành công!', 'Thành công');
            }
        }

        function copyToClipboard() {
            if (chapters.length === 0) {
                alert('Chưa có chương nào!');
                return;
            }

            let content = '';
            chapters.forEach((chapter, index) => {
                content += `\n\n${'='.repeat(60)}\n`;
                content += `CHƯƠNG ${index + 1}: ${chapter.title}\n`;
                content += `${'='.repeat(60)}\n\n`;
                content += chapter.content;
            });

            navigator.clipboard.writeText(content).then(() => {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.success('Đã sao chép!', 'Thành công');
                }
            });
        }

        function copyChapterToClipboard(index) {
            const chapter = chapters[index];
            navigator.clipboard.writeText(chapter.content).then(() => {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.success('Đã sao chép!', 'Thành công');
                }
            });
        }

        // Xem trước PDF
        function showPDFPreview() {
            if (chapters.length === 0) {
                alert('Chưa có chương nào!');
                return;
            }

            const preview = document.getElementById('pdfPreview');
            let html = '<div style="font-family: Arial, sans-serif; padding: 20px;">';
            
            chapters.forEach((chapter, index) => {
                html += `
                    <div style="margin-bottom: 40px;">
                        <h2 style="border-bottom: 2px solid #333; padding-bottom: 10px;">CHƯƠNG ${index + 1}: ${chapter.title}</h2>
                        <div style="margin-top: 20px; line-height: 1.8;">
                            ${chapter.content.split('\n').map(line => `<p style="margin: 10px 0;">${line}</p>`).join('')}
                        </div>
                    </div>
                `;
            });
            
            html += '</div>';
            preview.innerHTML = html;
            
            // Chuyển sang tab preview
            const previewTab = new bootstrap.Tab(document.getElementById('preview-tab'));
            previewTab.show();
        }

        // Tạo PDF
        function generatePDF() {
            if (chapters.length === 0) {
                alert('Chưa có chương nào!');
                return;
            }

            const element = document.getElementById('pdfPreview');
            
            const opt = {
                margin: 1,
                filename: 'noi_dung_sach.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save();
            
            if (typeof NotificationSystem !== 'undefined') {
                NotificationSystem.success('Đã tạo file PDF!', 'Thành công');
            }
        }

        // Lưu nháp
        function saveDraft() {
            const draft = {
                chapters: chapters,
                saveTime: new Date().toISOString()
            };
            localStorage.setItem('bookDraft', JSON.stringify(draft));
            
            if (typeof NotificationSystem !== 'undefined') {
                NotificationSystem.success('Đã lưu nháp!', 'Thành công');
            }
        }

        // Tải nháp
        function loadDraft() {
            const draftStr = localStorage.getItem('bookDraft');
            if (draftStr) {
                const draft = JSON.parse(draftStr);
                if (confirm('Tải nháp? Dữ liệu hiện tại sẽ bị thay thế.')) {
                    chapters = draft.chapters || [];
                    displayChapters();
                    updateChapterCount();
                    
                    if (typeof NotificationSystem !== 'undefined') {
                        NotificationSystem.success('Đã tải nháp!', 'Thành công');
                    }
                }
            } else {
                alert('Không có nháp nào được lưu!');
            }
        }

        // Áp dụng vào sản phẩm
        function applyToProduct() {
            if (chapters.length === 0) {
                alert('Chưa có chương nào!');
                return;
            }

            let mergedContent = '';
            chapters.forEach((chapter, index) => {
                mergedContent += '\n\n' + '='.repeat(60) + '\n';
                mergedContent += `CHƯƠNG ${index + 1}: ${chapter.title}\n`;
                mergedContent += '='.repeat(60) + '\n\n';
                mergedContent += chapter.content;
            });

            // Lưu vào localStorage để trang Add/Update có thể lấy
            localStorage.setItem('bookContentForProduct', mergedContent.trim());
            
            // Chuyển đến trang thêm sản phẩm
            window.location.href = '/Admin/Product/Add';
        }

        // Khi load trang, tự động tải nháp nếu có
        window.addEventListener('DOMContentLoaded', function() {
            const draftStr = localStorage.getItem('bookDraft');
            if (draftStr) {
                const draft = JSON.parse(draftStr);
                chapters = draft.chapters || [];
                if (chapters.length > 0) {
                    displayChapters();
                    updateChapterCount();
                }
            }
        });
    </script>
}

<style>
    .card {
        border-radius: 12px;
    }

    .nav-tabs .nav-link {
        border-radius: 8px 8px 0 0;
        border: none;
        color: #666;
    }

    .nav-tabs .nav-link:hover {
        background-color: #f8f9fa;
    }

    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        color: white;
    }

    #bookContent, #chapterContent {
        font-family: 'Segoe UI', sans-serif;
        line-height: 1.8;
        font-size: 14px;
    }

    #chaptersList table tbody tr:hover {
        background-color: #f8f9fa;
        transform: scale(1.01);
        transition: all 0.2s ease;
    }

    .tab-content {
        min-height: 400px;
    }

    .alert-info {
        border-left: 4px solid #0dcaf0;
    }

    #pdfPreview {
        font-family: 'Times New Roman', serif;
    }

    #pdfPreview h2 {
        color: #333;
        font-size: 24px;
    }

    #pdfPreview p {
        text-align: justify;
        font-size: 12pt;
    }
</style>

