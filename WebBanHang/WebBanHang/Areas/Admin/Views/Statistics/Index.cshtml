@{
    ViewData["Title"] = "Thống kê bán hàng";
    Layout = "_LayoutAdmin";

    var month = (int)ViewBag.Month;
    var year = (int)ViewBag.Year;
    var totalRevenueMonth = (decimal)ViewBag.TotalRevenueMonth;
    var topBooks = ViewBag.TopBooks as IEnumerable<dynamic>;
    var dailyRevenue = ViewBag.DailyRevenue as IEnumerable<dynamic>;
}

<div class="container-fluid py-3">
    <!-- Header: Filter + Revenue -->
    <div class="row mb-3 g-3">
        <div class="col-md-4">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == month)">Tháng @i</option>
                    }
                </select>
                <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                    @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year; y++)
                    {
                        <option value="@y" selected="@(y == year)">@y</option>
                    }
                </select>
            </form>
        </div>
        <div class="col-md-8">
            <div class="bg-success text-white p-3 rounded">
                <small class="d-block">Doanh thu @month/@year</small>
                <h4 class="mb-0">@totalRevenueMonth.ToString("N0") đ</h4>
            </div>
        </div>
    </div>

    <!-- Chart -->
    <div class="bg-white p-3 rounded mb-3">
        <canvas id="chart" height="80"></canvas>
    </div>

    <!-- Top Books -->
    <div class="bg-white rounded">
        <div class="border-bottom px-3 py-2 bg-light">
            <h6 class="mb-0 fw-bold">Top 5 sách bán chạy</h6>
        </div>
        @if (topBooks != null && topBooks.Any())
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr class="small text-muted">
                        <th width="50">#</th>
                        <th width="60">Ảnh</th>
                        <th>Tên sách</th>
                        <th width="100" class="text-center">SL</th>
                        <th width="120" class="text-end">Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var book in topBooks)
                    {
                        <tr>
                            <td class="text-center">
                                <span class="badge bg-secondary">@index</span>
                            </td>
                            <td>
                                <img src="@book.Image" alt="@book.BookName" 
                                     class="rounded" style="width:50px;height:70px;object-fit:cover;" />
                            </td>
                            <td class="small">@book.BookName</td>
                            <td class="text-center fw-bold">@book.Quantity</td>
                            <td class="text-end text-success fw-bold">@book.Revenue.ToString("N0") đ</td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <small>Không có dữ liệu</small>
            </div>
        }
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = [
        @foreach (var d in dailyRevenue)
        {
                @: "@d.Day",
        }
    ];

    const data = [
        @foreach (var d in dailyRevenue)
        {
                @: @d.Total,
        }
    ];

    const ctx = document.getElementById('chart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Doanh thu ngày (VNĐ)',
                data: data,
                borderColor: '#198754',
                backgroundColor: 'rgba(25, 135, 84, 0.2)',
                fill: true,
                tension: 0.3,
                borderWidth: 2,
                pointBackgroundColor: '#198754',
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: value => value.toLocaleString('vi-VN')
                    },
                    grid: { color: '#f0f0f0' }
                },
                x: { grid: { color: 'transparent' } }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: context => context.parsed.y.toLocaleString('vi-VN') + ' đ'
                    }
                }
            }
        }
    });
</script>
