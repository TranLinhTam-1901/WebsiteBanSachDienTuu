@using Microsoft.AspNetCore.Identity
@using WebBanHang.Models   <!-- cần thêm namespace của ApplicationUser -->
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        /* CSS tùy chỉnh để làm nổi bật menu con */
        .submenu-item {
            padding-left: 30px !important; /* Thụt lề cho mục con */
            font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <nav class="bg-dark text-white p-3 vh-100" style="width:250px;">
            <h4 class="text-center mb-4">Admin Panel</h4>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="fa fa-home"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                       data-bs-toggle="collapse"
                       href="#productSubmenu"
                       role="button"
                       aria-expanded="false"
                       aria-controls="productSubmenu">
                        <div><i class="fa fa-box"></i> Quản lý sản phẩm</div>
                        <i class="fas fa-chevron-down fa-xs"></i>
                    </a>

                    <div class="collapse" id="productSubmenu">
                        <ul class="nav flex-column ps-3">
                            <li class="nav-item">
                                <a class="nav-link text-white submenu-item" asp-area="Admin" asp-controller="Product" asp-action="Index">
                                    <i class="fa fa-book"></i> Quản lý Sách
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white submenu-item" asp-area="Admin" asp-controller="Category" asp-action="Index">
                                    <i class="fa fa-tags"></i> Quản lý Thể loại
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white submenu-item" asp-area="Admin" asp-controller="Statistics" asp-action="Index">
                                    <i class="fa fa-tags"></i> Quản lý Doanh Thu
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>


            @if (SignInManager.IsSignedIn(User))
            {
                <li class="nav-item">
                    <span class="text-muted small d-block mb-2"> User.IsInRole("Admin")</span>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0">
                        <button type="submit" class="btn btn-danger w-100">🚪 Đăng xuất</button>
                    </form>

                </li>
            }
            else
            {
                <li class="nav-item">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">🔑 Đăng nhập</a>
                </li>
            }
            </ul>
        </nav>

       
   

        <!-- Main content -->
        <div class="flex-grow-1 p-4">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>