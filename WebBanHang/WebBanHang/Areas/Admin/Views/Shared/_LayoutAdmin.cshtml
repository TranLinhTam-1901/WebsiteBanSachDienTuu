@using WebBanHang.Models
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f5f6fa;
            font-family: "Segoe UI", sans-serif;
        }
        .sidebar {
            height: 100vh;
            background-color: #1e1f26;
            padding: 20px 15px;
            position: fixed;
            width: 250px;
            top: 0;
            left: 0;
        }
        .sidebar h3 {
            color: #fff;
            text-align: center;
            font-weight: 600;
            margin-bottom: 30px;
        }
        .sidebar .nav-link {
            color: #cfd2d6;
            font-weight: 500;
            padding: 10px 15px;
            border-radius: 6px;
            transition: 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background-color: #3b3d4a;
            color: #fff;
        }
        .content {
            margin-left: 270px;
            padding: 25px 40px;
        }
        footer {
            text-align: center;
            color: #888;
            font-size: 0.9rem;
            padding: 10px 0;
            border-top: 1px solid #ddd;
            margin-top: 40px;
        }

        body {
            overflow-x: hidden;
        }

        /* ===== PROFESSIONAL NOTIFICATION SYSTEM ===== */
        .notification-container {
            position: fixed;
            top: 80px;
            right: 40px;
            z-index: 9999;
            max-width: 400px;
        }

        .notification-toast {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            padding: 16px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideIn 0.3s ease-out;
            border-left: 4px solid;
        }

        .notification-toast.error {
            border-left-color: #dc3545;
        }

        .notification-toast.warning {
            border-left-color: #ffc107;
        }

        .notification-toast.info {
            border-left-color: #17a2b8;
        }

        .notification-toast.success {
            border-left-color: #28a745;
        }

        .notification-icon {
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .notification-toast.error .notification-icon {
            background-color: #ffe8e8;
            color: #dc3545;
        }

        .notification-toast.warning .notification-icon {
            background-color: #fff3cd;
            color: #856404;
        }

        .notification-toast.info .notification-icon {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .notification-toast.success .notification-icon {
            background-color: #d4edda;
            color: #155724;
        }

        .notification-content {
            flex: 1;
        }

        .notification-title {
            font-weight: 600;
            font-size: 15px;
            margin-bottom: 4px;
            color: #333;
        }

        .notification-message {
            font-size: 14px;
            color: #666;
        }

        .notification-close {
            flex-shrink: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #999;
            border-radius: 50%;
            transition: all 0.2s;
        }

        .notification-close:hover {
            background-color: #f0f0f0;
            color: #666;
        }

        .notification-toast.fade-out {
            animation: slideOut 0.3s ease-out;
        }

        @@keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes slideOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }
            to {
                transform: translateX(400px);
                opacity: 0;
            }
        }

        @@media (max-width: 768px) {
            .notification-container {
                top: 10px;
                right: 10px;
                max-width: calc(100% - 20px);
            }

            .notification-toast {
                padding: 12px;
            }

            .notification-content {
                font-size: 14px;
            }

            .notification-icon {
                width: 36px;
                height: 36px;
                font-size: 18px;
            }
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h3>
            <a asp-area="Admin" asp-controller="Statistics" asp-action="Index" class="text-decoration-none text-white">
                <i class="fa fa-book"></i> 3T Books
            </a>
        </h3>

        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")"
               asp-area="Admin" asp-controller="Customer" asp-action="Index">
                <i class="fa fa-users"></i> Quản lý tài khoản
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
               asp-area="Admin" asp-controller="Product" asp-action="Index">
                <i class="fa fa-box"></i> Quản lý sản phẩm
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "BookEditor" ? "active" : "")"
               asp-area="Admin" asp-controller="BookEditor" asp-action="Index">
                <i class="fa fa-edit"></i> Công cụ soạn sách
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
               asp-area="Admin" asp-controller="Category" asp-action="Index">
                <i class="fa fa-tags"></i> Quản lý thể loại
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chat" ? "active" : "")"
               asp-area="Admin" asp-controller="Chat" asp-action="Index">
                <i class="fa fa-comments"></i> Quản lý Chat
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")"
               asp-area="Admin" asp-controller="Order" asp-action="Manage">
                <i class="fa fa-shopping-cart"></i> Quản lý đơn hàng 
            </a>
        </nav>
        <div class="mt-auto text-center">
            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="btn btn-danger w-100 mt-4">
                    <i class="fa fa-sign-out-alt"></i> Đăng xuất
                </button>
            </form>
        </div>
    </div>

    <div class="content">
        <main role="main">
            @RenderBody()
        </main>     
    </div>

    <!-- Notification Container -->
    <div class="notification-container" id="notificationContainer"></div>

    <!-- TempData Notifications -->
    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.success('@TempData["Success"]', 'Thành công');
                }
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.error('@TempData["Error"]', 'Lỗi');
                }
            });
        </script>
    }
    @if (TempData["Info"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.info('@TempData["Info"]', 'Thông tin');
                }
            });
        </script>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

