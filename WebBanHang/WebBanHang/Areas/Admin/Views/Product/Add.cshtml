@model WebBanHang.Models.Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">
            📝 Thêm Sách Mới
        </h2>
        <a asp-area="Admin" asp-controller="Import" asp-action="Index" class="btn btn-success shadow-sm">
            📥 Import sản phẩm
        </a>
    </div>

    <!-- Main Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4 bg-light">
            <form asp-action="Add" asp-controller="Product" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- PHẦN 1: THÔNG TIN CHUNG -->
                <h5 class="fw-bold text-dark mb-3">📘 Thông tin chung</h5>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold text-dark">Tên sách</label>
                        <input asp-for="Name" type="text" class="form-control shadow-sm" placeholder="Ví dụ: Atomic Habits..." />
                        <small class="text-muted">Nhập tiêu đề chính xác như bạn muốn hiển thị.</small>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label fw-semibold text-dark">Tác giả</label>
                        <input asp-for="Author" type="text" class="form-control shadow-sm" placeholder="Tên tác giả..." />
                        <small class="text-muted">Nhập tên thật hoặc bút danh của tác giả.</small>
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>
                </div>

                <!-- PHẦN 2: GIÁ & DANH MỤC -->
                <h5 class="fw-bold text-dark mb-3">💰 Giá & Danh mục</h5>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold text-dark">Giá (VNĐ)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control shadow-sm" placeholder="Ví dụ: 120000" />
                        <small class="text-muted">Giá bán hiển thị cho khách hàng (VNĐ).</small>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold text-dark">Danh mục</label>
                        <select asp-for="CategoryId" asp-items="@(ViewBag.Categories as SelectList)" class="form-select shadow-sm">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <small class="text-muted">Phân loại chính xác giúp người đọc dễ tìm hơn.</small>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- PHẦN 3: MÔ TẢ -->
                <h5 class="fw-bold text-dark mb-3">📝 Mô tả sách</h5>
                <div class="mb-4">
                    <textarea asp-for="Description" rows="5" class="form-control shadow-sm"
                              placeholder="Nhập mô tả nội dung hấp dẫn, ngắn gọn và súc tích..."></textarea>
                    <small class="text-muted">
                        Mô tả nên tập trung vào giá trị, nội dung chính và lợi ích khi đọc sách.
                    </small>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- PHẦN 4: ẢNH BÌA KIỂU KINDLE -->
                <h5 class="fw-bold text-dark mb-3">🖼️ Ảnh bìa sách</h5>
                <div class="bg-white p-4 border rounded shadow-sm mb-4">
                    <div class="d-flex align-items-center gap-4 flex-wrap">
                        <!-- Khung ảnh bìa -->
                        <div id="coverPreviewBox" class="border border-2 border-secondary-subtle rounded d-flex align-items-center justify-content-center flex-column"
                             style="width: 140px; height: 200px; border-style: dashed; background-color: #fafafa;">
                            <span class="text-muted small text-center" id="coverText">No Cover Uploaded</span>
                            <img id="coverPreview" src="#" alt="Cover Preview"
                                 style="display:none; width:100%; height:100%; object-fit:cover; border-radius:6px;" />
                        </div>

                        <!-- Nút upload -->
                        <div class="d-flex flex-column gap-2">
                            <label for="ImageFile" class="form-label fw-semibold text-dark mb-1">Tải ảnh bìa lên</label>
                            <input type="file" name="ImageFile" id="ImageFile" accept="image/*" class="form-control form-control-sm shadow-sm" />

                            <small class="text-muted mt-1">
                                Kích thước gợi ý: <strong>1600 x 2560 px</strong> (tỷ lệ 1.6:1)
                            </small>
                        </div>
                    </div>
                </div>

                <!-- PHẦN 5: NỘI DUNG PDF -->
                <h5 class="fw-bold text-dark mb-3">📂 File nội dung sách (PDF)</h5>
                <div class="bg-white p-4 border rounded shadow-sm mb-4">
                    <label for="PdfFile" class="form-label fw-semibold text-dark">Chọn file PDF</label>
                    <input type="file" name="PdfFile" accept="application/pdf" class="form-control shadow-sm" id="PdfFile" />
                    <small class="text-muted">Tải lên nội dung sách định dạng PDF (tối đa 50MB).</small>
                    <span asp-validation-for="BookContentUrl" class="text-danger small"></span>
                </div>

                <!-- Nút hành động -->
                <hr class="my-4" />
                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        💾 Lưu sản phẩm
                    </button>
                    <a asp-action="Index" asp-controller="Product" asp-area="Admin" class="btn btn-outline-secondary px-4">
                        ❌ Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Preview ảnh khi chọn -->
@section Scripts {
    <script>
        const imageInput = document.getElementById('ImageFile');
        const coverPreview = document.getElementById('coverPreview');
        const coverText = document.getElementById('coverText');

        imageInput.addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    coverPreview.src = e.target.result;
                    coverPreview.style.display = 'block';
                    coverText.style.display = 'none';
                };
                reader.readAsDataURL(file);
            } else {
                coverPreview.style.display = 'none';
                coverText.style.display = 'block';
            }
        });
    </script>
}

<style>
    .card {
        border-radius: 12px;
    }

    .form-label {
        color: #000;
    }

    .form-control, .form-select {
        border-radius: 8px;
        box-shadow: none;
        transition: all 0.2s ease-in-out;
        color: #000;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        }

    small.text-muted {
        font-size: 0.85rem;
    }

    h5.text-dark {
        border-left: 4px solid #000;
        padding-left: 8px;
    }

    hr {
        border-top: 2px solid #e9ecef;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }

    .btn-outline-secondary {
        border-radius: 8px;
    }

    #coverPreviewBox:hover {
        background-color: #f1f1f1;
        transition: 0.2s;
    }
</style>
