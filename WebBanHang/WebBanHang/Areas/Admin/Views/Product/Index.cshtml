@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">
            📚 Danh sách sản phẩm
        </h2>

        <a asp-action="Add" asp-area="Admin" asp-controller="Product" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-center align-middle">
                    <tr>
                        <th style="width: 80px;">Ảnh</th>
                        <th>Tên sách</th>
                        <th>Tác giả</th>
                        <th>Giá</th>
                        <th style="width: 250px;">Mô tả</th>
                        <th>Danh mục</th>
                        <th>File PDF</th>
                        <th style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="Ảnh bìa" class="rounded shadow-sm" width="60" height="80" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Author</td>
                            <td class="text-success fw-bold">@item.Price.ToString("N0") đ</td>
                            <td class="text-muted small" style="max-width:250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @item.Description
                            </td>
                            <td>@item.Category?.Name</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BookContentUrl))
                                {
                                    <a href="@item.BookContentUrl" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-file-earmark-pdf"></i> Xem
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Không có</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Update"
                                       asp-controller="Product"
                                       asp-area="Admin"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <button type="button"
                                            onclick="deleteProduct(@item.Id)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteProduct(id) {
            if (confirm("🗑️ Bạn có chắc chắn muốn xóa sản phẩm này không?")) {
                fetch(`/Admin/Product/Delete/${id}`, {
                    method: "POST"
                })
                    .then(res => {
                        if (res.ok) {
                            alert("✅ Xóa thành công!");
                            location.reload();
                        } else {
                            alert("❌ Xóa thất bại!");
                        }
                    });
            }
        }
    </script>
}

<style>
    h2.fw-bold {
        letter-spacing: 0.5px;
    }

    .table > :not(caption) > * > * {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s;
    }

    .btn-warning, .btn-danger {
        color: #fff !important;
    }

        .btn-warning:hover {
            background-color: #e6a700;
            border-color: #e6a700;
        }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #c82333;
        }
</style>
