@model IEnumerable<WebBanHang.Areas.Admin.Controllers.CustomerAccountViewModel>

@{
    ViewData["Title"] = "Quản lý tài khoản khách hàng";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-semibold">
                👥 Quản lý tài khoản khách hàng
            </h4>
            <span class="small text-light">
                Tổng số: <strong>@Model.Count()</strong> tài khoản
            </span>
        </div>

        <div class="card-body bg-light p-0">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-secondary text-center">
                        <tr>
                            <th>Tên đăng nhập</th>
                            <th>Email</th>
                            <th>Ngày tạo</th>
                            <th>Vai trò</th>
                            <th style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr class="bg-white">
                                <td class="fw-semibold text-dark">@user.UserName</td>
                                <td>@user.Email</td>
                                <td class="text-muted">
                                    @(user.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </td>

                                <!-- Vai trò -->
                                <td>
                                    @if (user.Roles.Contains("Admin"))
                                    {
                                        <span class="badge bg-danger px-3 py-2 shadow-sm">
                                            <i class="fa fa-crown me-1"></i> Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary px-3 py-2 shadow-sm">
                                            <i class="fa fa-user me-1"></i> User
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Nút đổi vai trò -->
                                        <form asp-action="ToggleRole" method="post" asp-route-id="@user.Id" class="d-inline">
                                            @if (user.Roles.Contains("Admin"))
                                            {
                                                <button type="submit" class="btn btn-outline-warning btn-sm fw-semibold" title="Chuyển thành User">
                                                    <i class="fa fa-arrow-down me-1"></i> User
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success btn-sm fw-semibold" title="Chuyển thành Admin">
                                                    <i class="fa fa-arrow-up me-1"></i> Admin
                                                </button>
                                            }
                                        </form>

                                        <!-- Nút xóa -->
                                        <form asp-action="Delete"
                                              asp-route-id="@user.Id"
                                              method="post"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xoá tài khoản này không?')"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold">
                                                <i class="fa fa-trash me-1"></i> Xoá
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fa fa-user-slash fs-3 mb-3 d-block"></i>
                    Hiện chưa có tài khoản khách hàng nào.
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* CARD */
    .card {
        border-radius: 14px;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(90deg, #1e1e1e, #343a40);
        padding: 1rem 1.5rem;
    }

    /* BẢNG */
    .table {
        margin-bottom: 0;
    }

    .table-hover tbody tr:hover {
        background-color: #f3f7ff !important;
        transition: background-color 0.2s ease-in-out;
    }

    .table-secondary {
        background-color: #f8f9fa !important;
    }

    .table thead th {
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.3px;
    }

    /* BADGE */
    .badge {
        font-size: 0.9rem;
        border-radius: 0.5rem;
        font-weight: 500;
    }

    /* NÚT */
    .btn-outline-success:hover {
        background-color: #198754;
        color: #fff;
    }

    .btn-outline-warning:hover {
        background-color: #ffc107;
        color: #212529;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: #fff;
    }
</style>
