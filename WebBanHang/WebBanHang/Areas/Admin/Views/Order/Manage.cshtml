@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "_LayoutAdmin";
}

<h2 class="mb-4"><i class="fa fa-wrench"></i> Quản lý đơn hàng</h2>

<!-- Bỏ thông báo admin -->

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Người dùng</th>
            <th>Tổng tiền</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <th>Thanh toán</th> <!-- ⚠️ [CHỈNH 2] Thêm cột thanh toán -->
            <th class="text-center">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@(string.IsNullOrEmpty(order.OrderCode) ? $"#{order.Id}" : order.OrderCode)</td>
                <td>@order.User?.FullName</td>
                <td>@order.Total.ToString("N0") đ</td>
                <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (order.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                    }
                    else if (order.Status == "Confirmed")
                    {
                        <span class="badge bg-success">Đã xác nhận</span>
                    }
                    else if (order.Status == "Canceled")
                    {
                        <span class="badge bg-danger">Đã hủy</span>
                    }
                    else if (order.Status == "Completed")
                    {
                        <span class="badge bg-primary">Hoàn tất</span>
                    }
                </td>
                <td>
                    <!-- ⚠️ [CHỈNH 3] Hiển thị rõ trạng thái thanh toán -->
                    @if (order.IsPaid)
                    {
                        <span class="badge bg-success">Đã TT</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chưa TT</span>
                    }
                </td>
                <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">

                        <!-- Nút xem chi tiết -->
                        <button class="btn btn-sm btn-info" onclick="showOrderDetails(@order.Id)">
                            <i class="fa fa-eye"></i> Xem
                        </button>

                        <!-- ⚠️ [CHỈNH 4] Admin chỉ được xác nhận / hủy nếu đơn đang chờ -->
                        @if (order.Status == "Pending")
                        {
                            <form asp-action="Confirm" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@order.Id" />
                                <button class="btn btn-sm btn-success" type="submit">
                                    <i class="fa fa-check"></i> Xác nhận
                                </button>
                            </form>

                            <form asp-action="Cancel" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@order.Id" />
                                <button class="btn btn-sm btn-danger" type="submit">
                                    <i class="fa fa-times"></i> Hủy
                                </button>
                            </form>
                        }

                        <!-- ⚠️ [CHỈNH 5] Nếu đơn đã xác nhận mà chưa thanh toán -->
                        @if (order.Status == "Confirmed" && !order.IsPaid)
                        {
                            <span class="badge bg-info">Đang chờ thanh toán</span>
                        }

                        <!-- ⚠️ [CHỈNH 6] Nếu đơn đã thanh toán -->
                        @if (order.IsPaid && order.Status == "Completed")
                        {
                            <span class="badge bg-primary">Hoàn tất</span>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal hiển thị chi tiết đơn -->
<div class="modal fade" id="orderModal" tabindex="-1" aria-labelledby="orderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="orderModalLabel">Chi tiết đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="orderModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Đang tải dữ liệu...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showOrderDetails(orderId) {
            const modal = new bootstrap.Modal(document.getElementById('orderModal'));
            modal.show();

            document.getElementById('orderModalBody').innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Đang tải dữ liệu...</p>
                </div>`;

            fetch('/Admin/Order/DetailsPartial/' + orderId)
                .then(response => response.text())
                .then(html => document.getElementById('orderModalBody').innerHTML = html)
                .catch(err => {
                    document.getElementById('orderModalBody').innerHTML = `
                        <div class="alert alert-danger">Không thể tải chi tiết đơn hàng.</div>`;
                });
        }
    </script>
}
