@model WebBanHang.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = null; 
}

<div class="p-3">

    <!-- 🧩 Thông tin người đặt -->
    <h6 class="fw-bold mb-3 text-secondary">
        👤 Thông tin người đặt
    </h6>
    <p><strong>Người đặt:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.User?.Email</p>
    <p><strong>SĐT:</strong> @Model.Phone</p>
    <p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>

    <p>
        <strong>Trạng thái đơn hàng:</strong>
        <span class="badge bg-@(Model.Status switch {
            "Pending" => "warning text-dark",
            "Confirmed" => "info text-dark",
            "Completed" => "success",
            "Canceled" => "danger",
            _ => "secondary"
        })">
            @Model.Status
        </span>
    </p>

    <p>
        <strong>Trạng thái thanh toán:</strong>
        @if (Model.IsPaid)
        {
            <span class="badge bg-success">Đã thanh toán</span>
        }
        else
        {
            <span class="badge bg-danger">Chưa thanh toán</span>
        }
    </p>

    <hr class="my-3" />

    <!-- 📚 Danh sách sản phẩm -->
    <h6 class="fw-bold mb-2 text-secondary">📦 Danh sách sản phẩm</h6>
    <table class="table table-bordered table-sm align-middle">
        <thead class="table-light">
            <tr>
                <th>Tên sách</th>
                <th class="text-center">Số lượng</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                    <td class="text-end">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="fw-bold text-end fs-5 mt-3">
        Tổng cộng: <span class="text-danger">@Model.Total.ToString("N0") đ</span>
    </p>

</div>
