@model WebBanHang.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="text-center py-5">
    <h2 class="text-success">Cảm ơn bạn đã đặt hàng!</h2>
    <p class="lead">Mã đơn hàng: <strong>#@Model.Id</strong></p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Chi tiết đơn hàng</h5>
        <ul class="list-group list-group-flush">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@item.Product?.Name</div>
                        <div class="small text-muted">x @item.Quantity</div>
                    </div>
                    <div>@((item.UnitPrice * item.Quantity).ToString("N0")) đ</div>
                </li>
            }
        </ul>

        <div class="mt-3">
            <div class="d-flex justify-content-between">
                <span>Tạm tính</span>
                <strong>@Model.Subtotal.ToString("N0") đ</strong>
            </div>
            <hr />
            <div class="d-flex justify-content-between fs-5">
                <span>Tổng cộng</span>
                <strong class="text-success">@Model.Total.ToString("N0") đ</strong>
            </div>
        </div>
    </div>
</div>
