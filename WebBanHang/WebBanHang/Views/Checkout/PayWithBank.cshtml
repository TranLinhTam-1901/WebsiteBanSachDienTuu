@model WebBanHang.Models.Order
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    var bankCode = ViewBag.BankCode as string ?? "MB";
    var bankName = ViewBag.BankCode == "TCB" ? "Techcombank" : "Vietnam Maritime Bank";
    var qrImage = bankCode == "TCB" ? "/Bank/TechComBank.jpg" : "/Bank/MbBank.jpg";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0">Thanh toán đơn hàng</h4>
                </div>
                <div class="card-body text-center">
                    <p class="text-muted">Mã đơn hàng: <strong class="text-primary">@Model.OrderCode</strong></p>
                    <p class="h3 text-success">@Model.Total.ToString("N0") đ</p>
                    
                    <hr />
                    
                    <h5 class="mb-3">Quét mã QR để thanh toán qua @bankName</h5>
                    
                    <div class="mb-3">
                        <img src="@qrImage" alt="QR Code" class="img-fluid border rounded" style="max-width: 300px;" />
                    </div>
                    
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Vui lòng chuyển khoản đúng số tiền và nội dung đơn hàng để được xử lý nhanh nhất.
                    </div>
                    
                    <form asp-action="ConfirmPayment" method="post" class="mt-4">
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <input type="hidden" name="bankCode" value="@bankCode" />
                        
                        <button type="submit" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-check-circle"></i> Tôi đã chuyển khoản
                        </button>
                    </form>
                    
                    <a href="@Url.Action("ChooseBank", "Checkout", new { orderId = Model.Id })" class="btn btn-outline-secondary mt-2">
                        <i class="bi bi-arrow-left"></i> Chọn ngân hàng khác
                    </a>
                </div>
            </div>
            
            <div class="mt-3">
                <div class="alert alert-warning">
                    <strong><i class="bi bi-exclamation-triangle"></i> Lưu ý:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Đơn hàng sẽ được xử lý sau khi admin xác nhận đã nhận tiền</li>
                        <li>Nếu chưa nhận được sách sau 24h, vui lòng liên hệ hotline</li>
                        <li>Quá trình xử lý có thể mất 1-2 giờ</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

