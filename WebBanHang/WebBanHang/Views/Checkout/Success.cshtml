@model WebBanHang.Models.Order
@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="alert alert-success mt-3 text-center p-4 shadow-sm" style="max-width: 700px; margin: 0 auto;">
    <h2>✅ Thanh toán thành công!</h2>
    <p><b>Mã đơn hàng:</b> @(string.IsNullOrEmpty(Model.OrderCode) ? $"#{Model.Id}" : Model.OrderCode)</p>
    <p><b>Mã giao dịch:</b> <code>@Model.TransactionId</code></p>
    <p class="mt-3">
        🎉 Cảm ơn bạn đã mua sách tại <strong>3T-Books</strong>!
        Sách của bạn đã được thêm vào thư viện cá nhân.
    </p>
</div>

<h4 class="mt-4">📚 Danh sách sách đã mua:</h4>
<ul class="list-group mb-4">
    @foreach (var item in Model.Items)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><b>@item.Product.Name</b></span>
            <div>
                <a asp-controller="Library"
                   asp-action="Read"
                   asp-route-id="@item.Product.Id"
                   class="btn btn-success btn-sm me-2">
                    📖 Đọc ngay
                </a>
                <a asp-controller="Library"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">
                    📚 Về thư viện
                </a>
            </div>
        </li>
    }
</ul>

<div class="text-center">
    <a asp-controller="Order"
       asp-action="Index"
       class="btn btn-outline-primary">
        ← Quay lại danh sách đơn hàng
    </a>
</div>
