@model WebBanHang.Models.Cart
@{
    ViewData["Title"] = "Thanh toán";
    decimal subtotal = (decimal)ViewBag.Subtotal;
    decimal total = (decimal)ViewBag.Total;
}

<h2 class="mb-4">Thanh toán</h2>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">Thông tin giao hàng</h5>
                <form asp-action="PlaceOrder" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-12">
                        <label class="form-label">Họ và tên</label>
                        <input type="text" name="fullName" class="form-control" required />
                    </div>
                    @* <div class="col-md-12">
                        <label class="form-label">Địa chỉ</label>
                        <input type="text" name="address" class="form-control" required />
                    </div> *@

                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" name="phone" class="form-control" required />
                    </div>

                    <div class="col-12 d-grid">
                        <button type="submit" class="btn btn-success btn-lg">Xác nhận đặt hàng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">Đơn hàng của bạn</h5>

                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@item.Product?.Name</div>
                                <div class="small text-muted">x @item.Quantity</div>
                            </div>
                            <div>@((item.UnitPrice * item.Quantity).ToString("N0")) đ</div>
                        </li>
                    }
                </ul>

                <div class="mt-3">
                    <div class="d-flex justify-content-between">
                        <span>Tạm tính</span>
                        <strong>@subtotal.ToString("N0") đ</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5">
                        <span>Tổng cộng</span>
                        <strong class="text-success">@total.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
