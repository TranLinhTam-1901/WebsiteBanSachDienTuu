@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Trang chủ - 3T Books";
}

<!-- 🎨 Hero Banner Section - Full Width Modern Design -->
<section class="hero-banner-full position-relative overflow-hidden" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin-bottom: 60px;">
    <div class="hero-inner-content">
        <div class="container-fluid px-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 col-xl-7 text-white">
                    <div class="hero-content">
                        <span class="badge bg-white text-primary mb-3 px-3 py-2 rounded-pill fs-6">📚 3T-Books - Thư Viện Số</span>
                        <h1 class="display-2 fw-bold mb-4 animate-fade-in">
                            Kho Sách Điện Tử <br/>
                            <span class="text-warning">Hàng Đầu</span> Việt Nam
                        </h1>
                        <p class="lead mb-4 opacity-90" style="font-size: 1.3rem;">
                            Khám phá hàng ngàn cuốn sách điện tử hay nhất, 
                            từ sách học tập đến sách giải trí. Mua ngay, đọc ngay, xây dựng thư viện của riêng bạn!
                        </p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="/Product/Index" class="btn btn-light btn-lg px-5 py-3 rounded-pill shadow-lg hover-lift">
                                <i class="bi bi-book me-2"></i>Khám phá ngay
                            </a>
                            <a href="/Library" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill hover-lift">
                                <i class="bi bi-bookshelf me-2"></i>Thư viện của tôi
                            </a>
                        </div>
                        
                        <!-- Stats Section -->
                        <div class="row g-4 mt-5">
                            <div class="col-4">
                                <div class="stat-item">
                                    <h2 class="fw-bold mb-1">10K+</h2>
                                    <p class="mb-0 opacity-75 small">Đầu sách</p>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item">
                                    <h2 class="fw-bold mb-1">50K+</h2>
                                    <p class="mb-0 opacity-75 small">Độc giả</p>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item">
                                    <h2 class="fw-bold mb-1">4.8/5</h2>
                                    <p class="mb-0 opacity-75 small">Đánh giá</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 col-xl-5">
                    <div class="hero-image text-center position-relative">
                        <div class="floating-books">
                            <i class="bi bi-book-half icon-book-1"></i>
                            <i class="bi bi-book icon-book-2"></i>
                            <i class="bi bi-journal-text icon-book-3"></i>
                            <i class="bi bi-journal-bookmark icon-book-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Decorative Elements -->
    <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
    </div>
    
    <!-- Wave bottom -->
    <svg class="hero-wave" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
        <path fill="#ffffff" fill-opacity="1" d="M0,160L48,170.7C96,181,192,203,288,218.7C384,235,480,245,576,213.3C672,181,768,107,864,85.3C960,64,1056,96,1152,117.3C1248,139,1344,149,1392,154.7L1440,160L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>
</section>


<section class="info-strip text-center py-4 bg-light border-top">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3">
                <i class="bi bi-truck fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Giao hàng miễn phí</h6>
                <p class="text-muted small">Áp dụng cho thành viên</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-shield-check fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Thanh toán an toàn</h6>
                <p class="text-muted small">Đảm bảo bảo mật tuyệt đối</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-headset fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Hỗ trợ 24/7</h6>
                <p class="text-muted small">Sẵn sàng phục vụ bạn</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-arrow-repeat fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Đổi trả trong 30 ngày</h6>
                <p class="text-muted small">Hoàn tiền hoặc đổi sản phẩm</p>
            </div>
        </div>
    </div>
</section>



<!-- CSS custom -->
<style>
    /* 🎨 Full Width Hero Banner Style */
    .hero-banner-full {
        position: relative;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 80px 0;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
    }
    
    .hero-inner-content {
        position: relative;
        z-index: 2;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        padding-right: 2rem;
    }
    
    .hero-wave {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100px;
        z-index: 1;
    }
    
    .stat-item {
        padding: 15px;
        background: rgba(255,255,255,0.1);
        border-radius: 12px;
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease;
    }
    
    .stat-item:hover {
        transform: translateY(-5px);
        background: rgba(255,255,255,0.15);
    }
    
    .hover-lift {
        transition: all 0.3s ease;
    }
    
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3) !important;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeIn 1s ease-out;
    }

    .floating-books {
        position: relative;
        height: 400px;
        width: 100%;
    }
    
    .icon-book-1 {
        font-size: 150px;
        color: rgba(255,255,255,0.3);
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation: float 3s ease-in-out infinite;
    }
    
    .icon-book-2 {
        font-size: 120px;
        color: rgba(255,255,255,0.25);
        position: absolute;
        top: 20px;
        right: 80px;
        animation: float 4s ease-in-out infinite;
        animation-delay: 0.5s;
    }
    
    .icon-book-3 {
        font-size: 100px;
        color: rgba(255,255,255,0.2);
        position: absolute;
        bottom: 60px;
        left: 40px;
        animation: float 3.5s ease-in-out infinite;
        animation-delay: 1s;
    }
    
    .icon-book-4 {
        font-size: 90px;
        color: rgba(255,255,255,0.18);
        position: absolute;
        top: 100px;
        left: 20px;
        animation: float 4.5s ease-in-out infinite;
        animation-delay: 1.5s;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    /* Decorative shapes */
    .hero-shapes {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
    }

    .shape {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        animation: float-shape 6s ease-in-out infinite;
    }

    .shape-1 {
        width: 200px;
        height: 200px;
        top: 10%;
        left: 10%;
    }

    .shape-2 {
        width: 150px;
        height: 150px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape-3 {
        width: 100px;
        height: 100px;
        bottom: 10%;
        left: 50%;
        animation-delay: 4s;
    }
    
    .shape-4 {
        width: 80px;
        height: 80px;
        top: 40%;
        left: 20%;
        animation-delay: 5s;
    }

    @@keyframes float-shape {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }
        50% {
            transform: translate(30px, -30px) scale(1.1);
        }
    }

    /* CSS cho tên sản phẩm - giới hạn 2 dòng */
    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
        max-height: 2.8em; /* 2 dòng x 1.4 line-height */
        word-wrap: break-word;
    }

    /* CSS cho slider sản phẩm */
    .products-slider-container {
        overflow: hidden;
        position: relative;
    }

    .products-slider {
        display: flex;
        transition: transform 0.3s ease-in-out;
        gap: 20px;
    }

    .slider-item {
        flex: 0 0 calc(20% - 16px); /* 5 sản phẩm trên 1 hàng */
        min-width: 0;
    }

    @@media (max-width: 1200px) {
        .slider-item {
            flex: 0 0 calc(25% - 15px); /* 4 sản phẩm trên tablet */
        }
    }

    @@media (max-width: 768px) {
        .slider-item {
            flex: 0 0 calc(50% - 10px); /* 2 sản phẩm trên mobile */
        }
    }

    @@media (max-width: 576px) {
        .slider-item {
            flex: 0 0 calc(100% - 0px); /* 1 sản phẩm trên mobile nhỏ */
        }
    }

    .slider-controls button {
        transition: all 0.2s ease;
    }

    .slider-controls button:hover {
        background-color: #198754;
        color: white;
        transform: scale(1.1);
    }
</style>


<!-- Sách bán chạy sửa ở đây nhé -->
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold mb-0">
            📚 Sách mới
        </h2>
        <div class="slider-controls">
            <button class="btn btn-outline-success rounded-circle me-2" id="prevBtn" style="width: 40px; height: 40px;">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-outline-success rounded-circle" id="nextBtn" style="width: 40px; height: 40px;">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Hiện chưa có sản phẩm nào.</p>
    }
    else
    {
        <div class="products-slider-container">
            <div class="products-slider" id="productsSlider">
                @foreach (var item in Model)
                {
                    <div class="slider-item">
                        <div class="card h-100 shadow-sm position-relative card-book">
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 280px; object-fit: contain; background-color: #f8f9fa;" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title mb-1 product-name">@item.Name</h5>
                                <p class="text-danger fw-bold mb-0">@string.Format("{0:N0}₫", item.Price)</p>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="stretched-link"></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const slider = document.getElementById('productsSlider');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            
            if (!slider || !prevBtn || !nextBtn) return;
            
            let currentIndex = 0;
            const itemsPerView = 5; // Hiển thị 5 sản phẩm cùng lúc
            const totalItems = slider.children.length;
            
            // Ẩn nút điều hướng nếu không đủ sản phẩm
            if (totalItems <= itemsPerView) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
                return;
            }
            
            function updateSlider() {
                const itemWidth = slider.children[0].offsetWidth + 20; // width + gap
                const translateX = -currentIndex * itemWidth;
                slider.style.transform = `translateX(${translateX}px)`;
                
                // Cập nhật trạng thái nút
                prevBtn.disabled = currentIndex === 0;
                nextBtn.disabled = currentIndex >= totalItems - itemsPerView;
            }
            
            prevBtn.addEventListener('click', function() {
                if (currentIndex > 0) {
                    currentIndex--;
                    updateSlider();
                }
            });
            
            nextBtn.addEventListener('click', function() {
                if (currentIndex < totalItems - itemsPerView) {
                    currentIndex++;
                    updateSlider();
                }
            });
            
            // Khởi tạo slider
            updateSlider();
        });
    </script>
}
