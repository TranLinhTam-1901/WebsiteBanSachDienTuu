@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Trang chủ - 3T Books";
}
<!-- 🎠 Hero Banner (Carousel) -->
<section id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
    <div class="carousel-inner">

        <!-- Ảnh 1 -->
        <div class="carousel-item active position-relative">
            <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f" class="d-block w-100 hero-img" alt="Banner 1">
            <div class="carousel-caption text-start">
                <h1 class="fw-bold display-5">Khám phá cuốn sách yêu thích tiếp theo 📖</h1>
                <p>Sách là người bạn yên lặng và thông thái nhất, luôn đồng hành cùng bạn trên mọi hành trình.</p>
                @* <a href="/Product/Index" class="btn btn-danger btn-lg px-4 rounded-pill">Khám phá ngay</a> *@
            </div>
        </div>

        <!-- Ảnh 2 -->
        <div class="carousel-item position-relative">
            <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794" class="d-block w-100 hero-img" alt="Banner 2">
            <div class="carousel-caption text-start">
                <h1 class="fw-bold display-5">Ưu đãi đặc biệt 🌟</h1>
                <p>Giảm giá 20% cho tất cả đơn hàng trong tuần này. Mua ngay kẻo lỡ!</p>
                @* <a href="/Product/Index" class="btn btn-warning btn-lg px-4 rounded-pill text-dark">Xem ưu đãi</a> *@
            </div>
        </div>

        <!-- Ảnh 3 -->
        <div class="carousel-item position-relative">
            <img src="https://images.unsplash.com/photo-1521587760476-6c12a4b040da" class="d-block w-100 hero-img" alt="Banner 3">
            <div class="carousel-caption text-start">
                <h1 class="fw-bold display-5">Sách mới về mỗi ngày ✨</h1>
                <p>Khám phá bộ sưu tập sách mới nhất — cập nhật liên tục trong tháng này.</p>
                @* <a href="/Product/Index" class="btn btn-success btn-lg px-4 rounded-pill">Xem ngay</a> *@
            </div>
        </div>
    </div>

    <!-- Nút điều hướng -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Trước</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Tiếp</span>
    </button>

    <!-- Dấu chấm nhỏ bên dưới -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
    </div>
</section>


<section class="info-strip text-center py-4 bg-light border-top">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3">
                <i class="bi bi-truck fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Giao hàng miễn phí</h6>
                <p class="text-muted small">Áp dụng cho thành viên</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-shield-check fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Thanh toán an toàn</h6>
                <p class="text-muted small">Đảm bảo bảo mật tuyệt đối</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-headset fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Hỗ trợ 24/7</h6>
                <p class="text-muted small">Sẵn sàng phục vụ bạn</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-arrow-repeat fs-2 text-success"></i>
                <h6 class="fw-bold mt-2">Đổi trả trong 30 ngày</h6>
                <p class="text-muted small">Hoàn tiền hoặc đổi sản phẩm</p>
            </div>
        </div>
    </div>
</section>



<!-- CSS custom -->
<style>
    /* 🎨 Hero Banner Style */
    .hero-banner {
        height: 75vh;
        overflow: hidden;
        position: relative;
        margin-bottom: 3rem;
    }

        .hero-banner .hero-img {
            object-fit: cover;
            height: 100%;
            width: 100%;
            filter: brightness(70%);
            transition: transform 6s ease;
        }

        .hero-banner:hover .hero-img {
            transform: scale(1.05);
        }

        .hero-banner h1 {
            font-size: 2.8rem;
            font-weight: 700;
            text-shadow: 1px 2px 4px rgba(0,0,0,0.5);
        }

        .hero-banner p {
            font-size: 1.15rem;
            color: #f8f9fa;
            max-width: 550px;
        }

        .hero-banner .btn {
            font-size: 1.1rem;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
    /* 🎠 Hero Carousel */
    #heroCarousel {
        height: 75vh;
        overflow: hidden;
        margin-bottom: 3rem;
    }

    .hero-img {
        height: 75vh;
        object-fit: cover;
        filter: brightness(70%);
    }

    .carousel-caption {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        left: 5%;
        text-align: left;
        max-width: 600px;
    }

        .carousel-caption h1 {
            text-shadow: 1px 2px 5px rgba(0, 0, 0, 0.5);
        }

        .carousel-caption p {
            color: #f8f9fa;
            font-size: 1.15rem;
        }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        filter: invert(1);
    }

    /* CSS cho tên sản phẩm - giới hạn 2 dòng */
    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
        max-height: 2.8em; /* 2 dòng x 1.4 line-height */
        word-wrap: break-word;
    }

    /* CSS cho slider sản phẩm */
    .products-slider-container {
        overflow: hidden;
        position: relative;
    }

    .products-slider {
        display: flex;
        transition: transform 0.3s ease-in-out;
        gap: 20px;
    }

    .slider-item {
        flex: 0 0 calc(20% - 16px); /* 5 sản phẩm trên 1 hàng */
        min-width: 0;
    }

    @@media (max-width: 1200px) {
        .slider-item {
            flex: 0 0 calc(25% - 15px); /* 4 sản phẩm trên tablet */
        }
    }

    @@media (max-width: 768px) {
        .slider-item {
            flex: 0 0 calc(50% - 10px); /* 2 sản phẩm trên mobile */
        }
    }

    @@media (max-width: 576px) {
        .slider-item {
            flex: 0 0 calc(100% - 0px); /* 1 sản phẩm trên mobile nhỏ */
        }
    }

    .slider-controls button {
        transition: all 0.2s ease;
    }

    .slider-controls button:hover {
        background-color: #198754;
        color: white;
        transform: scale(1.1);
    }
</style>


<!-- Sách bán chạy sửa ở đây nhé -->
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold mb-0">
            📚 Sách mới
        </h2>
        <div class="slider-controls">
            <button class="btn btn-outline-success rounded-circle me-2" id="prevBtn" style="width: 40px; height: 40px;">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-outline-success rounded-circle" id="nextBtn" style="width: 40px; height: 40px;">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Hiện chưa có sản phẩm nào.</p>
    }
    else
    {
        <div class="products-slider-container">
            <div class="products-slider" id="productsSlider">
                @foreach (var item in Model)
                {
                    <div class="slider-item">
                        <div class="card h-100 shadow-sm position-relative card-book">
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 280px; object-fit: contain; background-color: #f8f9fa;" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title mb-1 product-name">@item.Name</h5>
                                <p class="text-danger fw-bold mb-0">@string.Format("{0:N0}₫", item.Price)</p>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="stretched-link"></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const slider = document.getElementById('productsSlider');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            
            if (!slider || !prevBtn || !nextBtn) return;
            
            let currentIndex = 0;
            const itemsPerView = 5; // Hiển thị 5 sản phẩm cùng lúc
            const totalItems = slider.children.length;
            
            // Ẩn nút điều hướng nếu không đủ sản phẩm
            if (totalItems <= itemsPerView) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
                return;
            }
            
            function updateSlider() {
                const itemWidth = slider.children[0].offsetWidth + 20; // width + gap
                const translateX = -currentIndex * itemWidth;
                slider.style.transform = `translateX(${translateX}px)`;
                
                // Cập nhật trạng thái nút
                prevBtn.disabled = currentIndex === 0;
                nextBtn.disabled = currentIndex >= totalItems - itemsPerView;
            }
            
            prevBtn.addEventListener('click', function() {
                if (currentIndex > 0) {
                    currentIndex--;
                    updateSlider();
                }
            });
            
            nextBtn.addEventListener('click', function() {
                if (currentIndex < totalItems - itemsPerView) {
                    currentIndex++;
                    updateSlider();
                }
            });
            
            // Khởi tạo slider
            updateSlider();
        });
    </script>
}
