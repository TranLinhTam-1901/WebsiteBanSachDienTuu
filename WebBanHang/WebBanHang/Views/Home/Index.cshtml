@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Trang chủ - 3T Books";
}

<style>
        /* Banner layout fix */
        .hero-banner .banner-item {
            height: 100%; /* để các ảnh full chiều cao cột */
            overflow: hidden;
            border-radius: 10px;

        }
        .hero-banner {
        padding-left: 0;
        padding-right: 0;
    }
        .hero-banner .banner-item img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* ảnh full mà không méo */
            border-radius: 10px;
        }

        .hero-banner .banner-content {
            z-index: 2;
        }

        /* Đặt chiều cao đồng bộ */
        .hero-banner .col-lg-6:first-child .banner-item {
            height: 400px; /* banner lớn bên trái */
        }

        .hero-banner .col-lg-6 .col-12 .banner-item {
            height: 190px; /* banner trên bên phải */
        }

        .hero-banner .col-lg-6 .col-6 .banner-item {
            height: 190px; /* 2 banner dưới bên phải */
        }

        /* Nền mờ cho text */
        .hero-banner .banner-content {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 0 0 10px 10px;
            width: 100%;
        }
</style>

<div class="container-fluid mt-4 hero-banner">
    <div class="row g-3">
        <!-- Banner trái (chiếm nửa màn hình) -->
        <div class="col-lg-6">
            <div class="banner-item position-relative">
                <img src="https://images.csmonitor.com/csm/2021/03/1116885_1_0304-readers-rec_standard.jpg?alias=standard_900x600"
                     alt="Travel Books" />
                <div class="banner-content position-absolute bottom-0 start-0 p-4 text-white">
                    <h5>Your Guide To The World</h5>
                    <h2 class="fw-bold">Nên đọc<br />Sách hành trình</h2>
                    <a href="#" class="btn btn-light mt-2">Tìm hiểu ngay →</a>
                </div>
            </div>
        </div>

        <!-- Banner phải (chia thành 1 + 2) -->
        <div class="col-lg-6">
            <div class="row g-3">
                <!-- Banner trên -->
                <div class="col-12">
                    <div class="banner-item position-relative">
                        <img src="https://www.telegraph.co.uk/content/dam/books/2025/03/27/TELEMMGLPICT000417904878_17430757074830_trans_NvBQzQNjv4BqqVzuuqpFlyLIwiB6NTmJwfSVWeZ_vEN7c6bHu2jJnT8.jpeg?imwidth=640"
                             alt="Romance Books" />
                        <div class="banner-content position-absolute bottom-0 start-0 p-3 text-white">
                            <span class="small">Sách mới trong tuần</span>
                            <h5 class="fw-bold">Discover Our<br />Best Romance Books</h5>
                            <a href="#" class="btn btn-outline-light btn-sm mt-2">Discover Now</a>
                        </div>
                    </div>
                </div>

                <!-- Banner dưới chia đôi -->
                <div class="col-6">
                    <div class="banner-item position-relative">
                        <img src="https://i.etsystatic.com/25506687/r/il/a4a078/3690325814/il_fullxfull.3690325814_28h9.jpg"
                             alt="Sale" />
                        <div class="banner-content position-absolute bottom-0 start-0 text-white p-2">
                            <span class="small">Ưu đãi ngày hôm nay</span>
                            <h6>Giảm giá 20% <br />sử dụng mã: TTT</h6>
                            <a href="#" class="btn btn-light btn-sm mt-1">Shop Now</a>
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="banner-item position-relative">
                        <img src="https://d1imjpjik7kc4g.cloudfront.net/images/BCG-Attorney-Searchs-Guide-to-Corporate-and-Finance-Practice-Areas-new.jpg"
                             alt="Business" />
                        <div class="banner-content position-absolute bottom-0 start-0 text-white p-2">
                            <span class="small">New Arrivals</span>
                            <h6>Business Economics</h6>
                            <a href="#" class="btn btn-outline-light btn-sm mt-1">Discover Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- CSS custom -->
<style>
    .card-book {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .card-book:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
    .card-book img {
        transition: transform 0.3s;
    }
    .card-book:hover img {
        transform: scale(1.05);
    }

    /* CSS cho tên sản phẩm - giới hạn 2 dòng */
    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
        max-height: 2.8em; /* 2 dòng x 1.4 line-height */
        word-wrap: break-word;
    }

    /* CSS cho slider sản phẩm */
    .products-slider-container {
        overflow: hidden;
        position: relative;
    }

    .products-slider {
        display: flex;
        transition: transform 0.3s ease-in-out;
        gap: 20px;
    }

    .slider-item {
        flex: 0 0 calc(20% - 16px); /* 5 sản phẩm trên 1 hàng */
        min-width: 0;
    }

    @@media (max-width: 1200px) {
        .slider-item {
            flex: 0 0 calc(25% - 15px); /* 4 sản phẩm trên tablet */
        }
    }

    @@media (max-width: 768px) {
        .slider-item {
            flex: 0 0 calc(50% - 10px); /* 2 sản phẩm trên mobile */
        }
    }

    @@media (max-width: 576px) {
        .slider-item {
            flex: 0 0 calc(100% - 0px); /* 1 sản phẩm trên mobile nhỏ */
        }
    }

    .slider-controls button {
        transition: all 0.2s ease;
    }

    .slider-controls button:hover {
        background-color: #198754;
        color: white;
        transform: scale(1.1);
    }
</style>


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold mb-0">
            📚 Sách mới
        </h2>
        <div class="slider-controls">
            <button class="btn btn-outline-success rounded-circle me-2" id="prevBtn" style="width: 40px; height: 40px;">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-outline-success rounded-circle" id="nextBtn" style="width: 40px; height: 40px;">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">Hiện chưa có sản phẩm nào.</p>
    }
    else
    {
        <div class="products-slider-container">
            <div class="products-slider" id="productsSlider">
                @foreach (var item in Model)
                {
                    <div class="slider-item">
                        <div class="card h-100 shadow-sm position-relative card-book">
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 280px; object-fit: contain; background-color: #f8f9fa;" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title mb-1 product-name">@item.Name</h5>
                                <p class="text-danger fw-bold mb-0">@string.Format("{0:N0}₫", item.Price)</p>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="stretched-link"></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const slider = document.getElementById('productsSlider');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            
            if (!slider || !prevBtn || !nextBtn) return;
            
            let currentIndex = 0;
            const itemsPerView = 5; // Hiển thị 5 sản phẩm cùng lúc
            const totalItems = slider.children.length;
            
            // Ẩn nút điều hướng nếu không đủ sản phẩm
            if (totalItems <= itemsPerView) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
                return;
            }
            
            function updateSlider() {
                const itemWidth = slider.children[0].offsetWidth + 20; // width + gap
                const translateX = -currentIndex * itemWidth;
                slider.style.transform = `translateX(${translateX}px)`;
                
                // Cập nhật trạng thái nút
                prevBtn.disabled = currentIndex === 0;
                nextBtn.disabled = currentIndex >= totalItems - itemsPerView;
            }
            
            prevBtn.addEventListener('click', function() {
                if (currentIndex > 0) {
                    currentIndex--;
                    updateSlider();
                }
            });
            
            nextBtn.addEventListener('click', function() {
                if (currentIndex < totalItems - itemsPerView) {
                    currentIndex++;
                    updateSlider();
                }
            });
            
            // Khởi tạo slider
            updateSlider();
        });
    </script>
}
