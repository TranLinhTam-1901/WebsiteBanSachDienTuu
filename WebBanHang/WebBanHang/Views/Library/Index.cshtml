@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "Thư viện của tôi";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">📚 Thư viện của tôi</h2>
                <span class="badge bg-primary fs-6">@Model.Count() cuốn sách</span>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-book" style="font-size: 4rem; color: #6c757d;"></i>
            </div>
            <h4 class="text-muted">Chưa có sách nào</h4>
            <p class="text-muted">Hãy mua sách để bắt đầu xây dựng thư viện của bạn!</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-shop me-2"></i>Khám phá sách
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="position-relative">
                            <img src="@book.ImageUrl" class="card-img-top" alt="@book.Name" 
                                 style="height: 280px; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Sở hữu
                                </span>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; height: 2.8em;">
                                @book.Name
                            </h6>
                            <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3; height: 2.6em;">
                                @book.Description
                            </p>
                            <div class="mt-auto">
                                <a asp-action="Read" asp-route-id="@book.Id" class="btn btn-primary w-100">
                                    <i class="bi bi-book me-2"></i>Đọc ngay
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }
    
    .card-img-top {
        transition: transform 0.2s ease-in-out;
    }
    
    .card:hover .card-img-top {
        transform: scale(1.02);
    }
</style>
