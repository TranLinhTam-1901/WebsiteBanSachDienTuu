@model WebBanHang.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid py-4 bg-light">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">@Model.Name</h4>
            <small class="text-muted">by @Model.Author</small>
        </div>

        <div class="d-flex gap-2">
            <button id="fullscreenBtn" class="btn btn-outline-success btn-sm">
                <i class="bi bi-arrows-fullscreen"></i> Toàn màn hình
            </button>
            <a asp-controller="Library" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                ⏪ Thư viện
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.BookContentUrl))
    {
        <div id="pdf-viewer"
             style="height:85vh; overflow:auto; background:#111; padding:12px; border-radius:8px;">
        </div>

        <div class="text-end mt-2">
            <small id="progress" class="text-muted"></small>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">
            ❌ Không có nội dung sách để hiển thị. Vui lòng liên hệ admin.
        </div>
    }
</div>

<style>
    #pdf-viewer canvas {
        display: block;
        margin: 0 auto 12px;
        background: #fff;
        box-shadow: 0 2px 10px rgba(0,0,0,.25);
    }

    #pdf-viewer.fullscreen {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        background: #000;
        z-index: 9999;
        padding: 0;
        overflow: auto;
    }

    :fullscreen nav, :fullscreen footer {
        display: none !important;
    }
</style>

@* <!-- 🧩 PDF.js CDN chính thức -->
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js"></script> *@

<script>
    (() => {
        const pdfUrl = '@Url.Content(Model.BookContentUrl)';
        const productId = @Model.Id;
        const startPercent = Number('@(ViewBag.ProgressPercent ?? 0)');

        const pdfjsLib = window['pdfjsLib'];
        pdfjsLib.GlobalWorkerOptions.workerSrc =
            'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';

        const viewer = document.getElementById('pdf-viewer');
        const progressEl = document.getElementById('progress');

        if (!viewer) return;

        // ====== 1️⃣ HIỂN THỊ NỘI DUNG PDF ======
        pdfjsLib.getDocument(pdfUrl).promise.then(async pdf => {
            for (let i = 1; i <= pdf.numPages; i++) {
                const page = await pdf.getPage(i);
                const scale = 1.3;
                const vp = page.getViewport({ scale });
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                canvas.width = vp.width;
                canvas.height = vp.height;
                await page.render({ canvasContext: ctx, viewport: vp }).promise;
                viewer.appendChild(canvas);
            }

            // 🟢 Sau khi render xong toàn bộ, tự động cuộn về tiến trình đã lưu
            if (startPercent > 0) {
                setTimeout(() => {
                    const max = viewer.scrollHeight - viewer.clientHeight;
                    viewer.scrollTop = (startPercent / 100) * max;
                    progressEl.textContent = `Đang đọc: ${startPercent.toFixed(1)}%`;
                }, 400); // đợi một chút để DOM ổn định
            }
        });

        // ====== 2️⃣ LƯU TIẾN TRÌNH TỰ ĐỘNG ======
        let lastSave = 0;
        viewer.addEventListener('scroll', () => {
            const max = viewer.scrollHeight - viewer.clientHeight;
            const percent = max <= 0 ? 0 : (viewer.scrollTop / max) * 100;
            progressEl.textContent = `Đang đọc: ${percent.toFixed(1)}%`;

            const now = Date.now();
            // Lưu mỗi 2 giây 1 lần để tránh spam server
            if (now - lastSave > 2000) {
                lastSave = now;
                fetch('/Library/SaveProgress', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId, percent })
                });
            }
        });

        // ====== 3️⃣ TOÀN MÀN HÌNH ======
        const btn = document.getElementById('fullscreenBtn');
        if (btn) {
            btn.addEventListener('click', () => {
                if (!document.fullscreenElement) {
                    viewer.requestFullscreen?.();
                    viewer.classList.add('fullscreen');
                    btn.innerHTML = '<i class="bi bi-fullscreen-exit"></i> Thoát toàn màn hình';
                } else {
                    document.exitFullscreen?.();
                    viewer.classList.remove('fullscreen');
                    btn.innerHTML = '<i class="bi bi-arrows-fullscreen"></i> Toàn màn hình';
                }
            });

            document.addEventListener('fullscreenchange', () => {
                if (!document.fullscreenElement) {
                    viewer.classList.remove('fullscreen');
                    btn.innerHTML = '<i class="bi bi-arrows-fullscreen"></i> Toàn màn hình';
                }
            });
        }

        // ====== 4️⃣ CHẶN COPY / IN / CHUỘT PHẢI ======
        document.addEventListener('contextmenu', e => e.preventDefault());
        document.addEventListener('copy', e => e.preventDefault());
        document.addEventListener('keydown', e => {
            if ((e.ctrlKey || e.metaKey) && ['p', 's', 'u', 'c'].includes(e.key.toLowerCase())) {
                e.preventDefault(); // chặn Ctrl+P, Ctrl+S, Ctrl+U, Ctrl+C
            }
        });
    })();
</script>
