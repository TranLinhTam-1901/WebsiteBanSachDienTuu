@model WebBanHang.Models.Cart
@{
    ViewData["Title"] = "Giỏ hàng";
    decimal subtotal = Model.Items.Sum(i => i.UnitPrice * i.Quantity);
    //decimal shipping = subtotal > 0 ? 15000 : 0;
    decimal total = subtotal;
}

<h2 class="mb-4">Giỏ hàng</h2>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Giỏ hàng trống.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="table-responsive shadow-sm rounded">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sách</th>
                            <th style="width:140px">Giá</th>
                            <th style="width:220px">Số lượng</th>
                            <th style="width:140px">Tạm tính</th>
                            <th style="width:80px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Product?.Name</div>
                                    <div class="text-muted small">@item.Product?.Author</div>
                                </td>
                                <td>@item.UnitPrice.ToString("N0") đ</td>
                                <td>
                                    <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control" style="width:100px" />
                                        <button type="submit" class="btn btn-sm btn-primary">Cập nhật</button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                                <td>@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
                                <td>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Tổng kết đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính</span>
                        <strong>@subtotal.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        @* <span>Phí vận chuyển</span> *@
                        @* <strong>@shipping.ToString("N0") đ</strong> *@
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fs-5 mb-3">
                        <span>Tổng cộng</span>
                        <strong class="text-success">@total.ToString("N0") đ</strong>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success">Thanh toán</a>
                        <form asp-action="Clear" method="post">
                            <button type="submit" class="btn btn-outline-secondary">Xóa tất cả</button>
                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


