@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<div class="container py-4">

    <!-- ✅ Tiêu đề kết quả -->
    <h2 class="fw-bold mb-4 text-dark">
        <i class="bi bi-search text-success"></i> Kết quả tìm kiếm
    </h2>

    <!-- ✅ Thông báo khi không có kết quả -->
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info text-center shadow-sm mb-4">
            @Html.Raw(ViewBag.Message)
        </div>
    }

    <!-- ✅ Hiển thị danh sách sản phẩm -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm product-card">
                        <div class="ratio ratio-4x3 bg-light d-flex align-items-center justify-content-center">
                            <img src="@product.ImageUrl"
                                 alt="@product.Name"
                                 class="img-fluid p-2"
                                 style="max-height:220px; object-fit:contain;" />
                        </div>
                        <div class="card-body text-center">
                            <h6 class="fw-semibold product-name mb-1">@product.Name</h6>
                            <p class="text-muted small mb-1">@product.Author</p>
                            <p class="text-danger fw-bold mb-0">@product.Price.ToString("N0") đ</p>
                        </div>
                        <a asp-action="Details" asp-route-id="@product.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    }
    @* else
    {
        <div class="alert alert-warning text-center fw-semibold shadow-sm">
            <i class="bi bi-exclamation-circle"></i> Không tìm thấy sản phẩm phù hợp.
        </div>
    } *@
</div>

<style>
    .product-card {
        border-radius: 12px;
        transition: all 0.25s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
        min-height: 2.8em;
    }
</style>
