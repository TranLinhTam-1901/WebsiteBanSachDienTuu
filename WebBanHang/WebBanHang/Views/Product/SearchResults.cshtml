@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<div class="container py-4">
    <h2 class="text-success fw-bold mb-4">
        <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm nâng cao
    </h2>

    <form method="get" asp-controller="Product" asp-action="Search"
          class="bg-light shadow-sm rounded p-4 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark">
                    <i class="bi bi-search me-1"></i>Từ khóa
                </label>
                <input type="text" name="keyword" value="@ViewBag.Keyword"
                       class="form-control" placeholder="Nhập từ khóa sản phẩm..." />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold text-dark">
                    <i class="bi bi-person me-1"></i>Tác giả
                </label>
                <input type="text" name="author" value="@ViewBag.Author"
                       class="form-control" placeholder="Tác giả..." />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold text-dark">
                    <i class="bi bi-currency-dollar me-1"></i>Giá tối đa
                </label>
                <div class="input-group">
                    <input type="text" id="priceDisplay"
                           class="form-control"
                           placeholder="Nhập giá tối đa..."
                           value="@(ViewBag.MaxPrice != null ? string.Format("{0:N0}", ViewBag.MaxPrice) : "")" />
                    <input type="hidden" id="maxPrice" name="maxPrice" value="@ViewBag.MaxPrice" />
                    <span class="input-group-text">₫</span>
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold text-dark">
                    <i class="bi bi-gear me-1"></i>Thao tác
                </label>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-search me-1"></i>Tìm kiếm
                    </button>
                    <a href="/Product/Search" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-clockwise me-1"></i>Xóa bộ lọc
                    </a>
                </div>
            </div>
        </div>
    </form>

    <hr />

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info text-center shadow-sm mb-4">
            @Html.Raw(ViewBag.Message)
        </div>
    }

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 position-relative shadow-sm">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 280px; object-fit: contain; background-color: #f8f9fa;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-1 product-name">@product.Name</h5>
                        <p class="card-text text-muted small mb-2">@product.Author</p>
                        <p class="text-danger fw-bold mb-0">@product.Price.ToString("N0") đ</p>
                        <a asp-action="Details" asp-route-id="@product.Id" class="stretched-link"></a>
                    </div>
                </div>
            }
        </div>
    }
    @* else
    {
        <div class="alert alert-warning text-center fw-semibold shadow-sm">
            <i class="bi bi-exclamation-circle"></i> Không tìm thấy sản phẩm phù hợp.
        </div>
    } *@
</div>

<style>
    /* Card styling */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    /* CSS cho tên sản phẩm - giới hạn 2 dòng */
    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
        min-height: 2.8em;
    }

    /* Advanced search form styling */
    .bg-light {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%) !important;
        border: 1px solid #dee2e6;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #ced4da;
        transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    }

    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #20c997 0%, #17a2b8 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
    }

    .btn-secondary {
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(108, 117, 125, 0.3);
    }

    /* Input group styling */
    .input-group-text {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        font-weight: 600;
    }

    /* Header styling */
    h2 {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Results count styling */
    .text-muted {
        font-size: 1.1rem;
        font-weight: 500;
    }
</style>
