@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "Tìm kiếm nâng cao";
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning text-center fw-semibold mt-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.ErrorMessage
    </div>
}

<div class="container py-4">
    <h2 class="text-success fw-bold mb-4">
        <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm nâng cao
    </h2>

    <form method="get" asp-controller="Product" asp-action="Search"
          class="bg-light shadow-sm rounded p-4 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <input type="text" name="keyword" value="@ViewBag.Keyword"
                       class="form-control" placeholder="Nhập từ khóa sản phẩm..." />
            </div>

            <div class="col-md-2">
                <input type="text" name="author" value="@ViewBag.Author"
                       class="form-control" placeholder="Tác giả..." />
            </div>

            <div class="col-md-3">
                <div class="input-group">
                    <input type="text" id="priceDisplay"
                           class="form-control"
                           placeholder="Nhập giá tối đa (VNĐ)..."
                           value="@(ViewBag.MaxPrice != null ? string.Format("{0:N0}", ViewBag.MaxPrice) : "")" />
                    <input type="hidden" id="maxPrice" name="maxPrice" value="@ViewBag.MaxPrice" />
                    <span class="input-group-text">₫</span>
                </div>
            </div>


            <div class="col-md-1">
                <select name="inStock" class="form-select">
                    <option value="">Kho</option>
                    @{
                        var inStockValue = ViewBag.InStock;
                    }
                    <option value="true" selected="@(inStockValue == true ? "selected" : null)">Còn</option>
                    <option value="false" selected="@(inStockValue == false ? "selected" : null)">Hết</option>
                </select>
            </div>
        </div>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success px-4 me-2">
                <i class="fa fa-search"></i> Tìm kiếm
            </button>
            <a href="/Product/Search" class="btn btn-secondary">Xóa bộ lọc</a>
        </div>
    </form>

    <hr />

    @if (ViewBag.Message != null)
    {
        <p class="text-muted mb-3">@ViewBag.Message</p>
    }

    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="@product.ImageUrl" class="card-img-top rounded-top" alt="@product.Name" />
                    <div class="card-body text-center">
                        <h6 class="fw-bold product-name">@product.Name</h6>
                        
                        <p class="text-danger fw-semibold">@product.Price.ToString("N0") đ</p>
                        <a asp-action="Details" asp-route-id="@product.Id"
                           class="btn btn-outline-success btn-sm">
                            <i class="fa fa-eye"></i> Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* CSS cho tên sản phẩm - giới hạn 2 dòng */
    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.4;
        max-height: 2.8em; /* 2 dòng x 1.4 line-height */
        word-wrap: break-word;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const display = document.getElementById("priceDisplay");
        const hidden = document.getElementById("maxPrice");

        display.addEventListener("input", () => {
            // Xóa ký tự không phải số
            let raw = display.value.replace(/\D/g, "");
            hidden.value = raw; // gán lại giá trị thực gửi về server
            // Format hiển thị: 1.000.000
            display.value = new Intl.NumberFormat("vi-VN").format(raw);
        });
    });
</script>
