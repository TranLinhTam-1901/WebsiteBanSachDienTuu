@model WebBanHang.Models.ProductDetailViewModel

<div class="container py-4">
    <div class="row">
        <div class="col-md-5">
            <img src="@Model.Product.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Product.Name" />
        </div>
        <div class="col-md-7">
            <h2>@Model.Product.Name</h2>
            <p class="text-muted">@Model.Product.Description</p>
            <h4 class="text-success">@Model.Product.Price.ToString("C0")</h4>

            <div class="mt-3">
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                    <input type="number" name="quantity" value="1" min="1" class="form-control d-inline" style="width:100px;display:inline-block" />
                    <button type="submit" class="btn btn-success btn-lg me-2">Thêm vào giỏ</button>
                    @Html.AntiForgeryToken()
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Quay lại</a>
            </div>
        </div>
    </div>
</div>

<hr class="my-5" />
<div class="bg-light p-4 rounded">
    <h3 class="mb-4 text-danger">Bình luận và Đánh giá</h3>

    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        foreach (var review in Model.Reviews)
        {

            <div class="border-bottom pb-3 mb-3">
                <strong>@(review.User?.UserName ?? "Người dùng ẩn danh")</strong>
                <span class="text-warning">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= review.Rating)
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-star"></i>
                        }
                    }
                </span>
                <span class="text-muted">(@review.Rating/5)</span>

                <p>@review.Comment</p>
                <small class="text-muted">Ngày: @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
            </div>

            @if (!string.IsNullOrEmpty(review.ImageUrl))
            {
                <div class="mt-2">
                    <img src="@review.ImageUrl" alt="Hình ảnh đánh giá" class="img-thumbnail" style="max-width: 250px;" />
                </div>
            }
        }
    }
    else
    {
        <p class="text-muted">Chưa có bình luận nào cho cuốn sách này.</p>
    }

    <h4 class="mt-5 text-primary">Viết bình luận của bạn</h4>

    <form asp-action="AddReview" method="post" enctype="multipart/form-data">
        <input type="hidden" name="productId" value="@Model.Product.Id" />

        <div class="mb-3">
            <label class="form-label fw-bold">Đánh giá:</label>
            <div id="rating-container" class="d-flex gap-2">
                @for (int i = 1; i <= 5; i++)
                {
                    <input type="radio" name="rating" value="@i" id="star@i" class="d-none" />
                    <label for="star@i" class="rating-star" data-value="@i" style="font-size: 2rem; color: #ccc; cursor: pointer;">
                        <i class="bi bi-star-fill"></i>
                    </label>
                }
            </div>
        </div>

        @section Scripts {
            <script>
                const stars = document.querySelectorAll('.rating-star');

                stars.forEach((star, index) => {
                    star.addEventListener('click', () => {
                        // cập nhật màu sao
                        stars.forEach(s => s.style.color = '#ccc');
                        for (let i = 0; i <= index; i++) {
                            stars[i].style.color = '#ffc107';
                        }

                        // set checked cho input radio tương ứng
                        const radio = document.getElementById('star' + (index + 1));
                        if (radio) radio.checked = true;
                    });
                });
            </script>
        }


        <div class="mb-3">
            <label class="form-label">Nội dung bình luận:</label>
            <textarea name="comment" class="form-control" rows="4" placeholder="Nhập cảm nhận của bạn..."></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Thêm hình ảnh (tùy chọn):</label>
            <input type="file" name="imageFile" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Gửi bình luận</button>
    </form>
</div>


<style>
    .star-label:hover i {
        color: #ffcc00 !important;
        transform: scale(1.2);
        transition: 0.2s;
    }
</style>