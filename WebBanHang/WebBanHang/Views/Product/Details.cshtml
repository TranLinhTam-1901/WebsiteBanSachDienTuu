@model WebBanHang.Models.Product

<div class="container py-4">
    <div class="row">
        <div class="col-md-5">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" />
        </div>
        <div class="col-md-7">
            <h2>@Model.Name</h2>
            <p class="text-muted">@Model.Description</p>
            <h4 class="text-success">@Model.Price.ToString("C0")</h4>

            <div class="mt-3">
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="number" name="quantity" value="1" min="1" class="form-control d-inline" style="width:100px;display:inline-block" />
                    <button type="submit" class="btn btn-success btn-lg me-2">Thêm vào giỏ</button>
                    @Html.AntiForgeryToken()
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Quay lại</a>
            </div>
        </div>
    </div>
</div>
