@model WebBanHang.Models.Product

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
        <div class="row g-4 align-items-start">
            <!-- ẢNH BÌA SÁCH -->
            <div class="col-md-4 text-center">
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="img-fluid rounded shadow-sm mb-3"
                     style="max-height: 480px; object-fit: contain; width: 100%;" />
            </div>

            <!-- THÔNG TIN + GIÁ + THỂ LOẠI -->
            <div class="col-md-8">
                <div class="d-flex flex-column h-100 justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-2">@Model.Name</h2>
                        <p class="mb-2 text-secondary">
                            Tác giả: <span class="fw-semibold text-dark">@Model.Author</span>
                        </p>

                        <p class="text-secondary lh-base mb-3" style="max-width: 700px;">
                            @Model.Description
                        </p>

                        <div class="mb-3">
                            <span class="badge bg-primary fs-6 px-3 py-2">
                                Thể loại: @Model.Category?.Name
                            </span>
                        </div>
                    </div>

                    <!-- GIÁ + NÚT MUA -->
                    <div class="mt-auto">
                        <div class="d-flex align-items-center mb-3">
                            <span class="fs-3 fw-bold text-danger me-3">
                                @Model.Price.ToString("N0") đ
                            </span>
                        </div>

                        @if (User.Identity.IsAuthenticated)
                        {
                            // Kiểm tra xem người dùng đã sở hữu sách này chưa
                            var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            bool alreadyOwned = false;
                            if (!string.IsNullOrEmpty(userId))
                            {
                                // Kiểm tra trong database (có thể cache lại để tối ưu)
                                alreadyOwned = ViewBag.AlreadyOwned ?? false;
                            }

                            if (alreadyOwned)
                            {
                                <div class="alert alert-success p-2">
                                    📚 Cuốn sách đã có trong thư viện của bạn.
                                    <a asp-controller="Library" asp-action="Index" class="alert-link">Xem thư viện</a>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <form asp-controller="Checkout" asp-action="BuyNow" method="post" class="flex-fill">
                                        <input type="hidden" name="productId" value="@Model.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-warning px-3 py-2 fw-bold shadow-sm w-100" id="buyNowBtn">
                                            Mua ngay @Model.Price.ToString("N0")đ
                                        </button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
                                        <input type="hidden" name="productId" value="@Model.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-outline-success px-3 py-2 fw-semibold w-100" id="addToCartBtn">
                                            🛒 Thêm giỏ
                                        </button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a asp-area="Identity" asp-page="/Account/Login" 
                                   asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.Id })"
                                   class="btn btn-warning px-3 py-2 fw-bold shadow-sm flex-fill">
                                    Mua ngay @Model.Price.ToString("N0")đ
                                </a>
                                <a asp-area="Identity" asp-page="/Account/Login" 
                                   asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.Id })"
                                   class="btn btn-outline-success px-3 py-2 fw-semibold flex-fill">
                                    🛒 Thêm giỏ
                                </a>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Vui lòng đăng nhập để mua sản phẩm
                                </small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Hiệu ứng khi mua ngay
        document.getElementById('buyNowBtn').addEventListener('click', function(e) {
            // Có thể thêm hiệu ứng loading hoặc redirect ngay
        });
    </script>
}

<style>
    /* Hiệu ứng cho nút */
    .btn {
        transition: all 0.3s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    /* Animation cho card */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }
</style>