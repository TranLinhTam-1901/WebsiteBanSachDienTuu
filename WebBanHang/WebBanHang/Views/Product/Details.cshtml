@model WebBanHang.Models.Product

<div class="container py-4">
    <div class="row">
        <div class="col-md-5">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" />
        </div>
        <div class="col-md-7">
            <h2>@Model.Name</h2>
            <p class="text-muted">@Model.Description</p>
            <h4 class="text-success">@Model.Price.ToString("C0")</h4>

            <div class="mt-3">
                <a href="#" class="btn btn-success btn-lg me-2">Mua Ngay</a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Quay lại</a>
            </div>
        </div>
    </div>
</div>
