@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="order-page">
    <!-- Header -->
    <div class="order-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="fw-bold mb-2">
                    <i class="bi bi-receipt text-primary me-2"></i>
                    Đơn hàng của tôi
                </h1>
                <p class="text-muted mb-0">Lịch sử và chi tiết đơn hàng</p>
            </div>
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">
                    <i class="bi bi-cart me-1"></i>
                    @Model.Count() đơn hàng
                </span>
            </div>
        </div>
    </div>

    <!-- Content -->
    @if (!Model.Any())
    {
        <div class="empty-orders">
            <div class="empty-icon">
                <i class="bi bi-receipt"></i>
            </div>
            <h3 class="empty-title">Chưa có đơn hàng</h3>
            <p class="empty-text">Bạn chưa có đơn hàng nào.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-bag-plus me-2"></i>Mua sách ngay
            </a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in Model)
            {
                <div class="order-item">
                    <div class="order-main">
                        <div class="order-info">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <h5 class="order-code mb-0">@(string.IsNullOrEmpty(order.OrderCode) ? $"#{order.Id}" : order.OrderCode)</h5>
                                <span class="order-date">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    @order.CreatedAt.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                            <div class="order-products">
                                @foreach (var item in order.Items)
                                {
                                    <div class="product-item">
                                        <i class="bi bi-book me-2 text-muted"></i>
                                        <span>@item.Product.Name x @item.Quantity</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="order-status-section">
                            <div class="order-amount">
                                <span class="amount-label">Tổng:</span>
                                <span class="amount-value">@order.Total.ToString("N0") ₫</span>
                            </div>
                            <div class="status-badge badge-@order.Status.ToLower()">
                                @switch (order.Status)
                                {
                                    case "Pending":
                                        <i class="bi bi-clock me-1"></i>
                                        <span>Chờ xác nhận</span>
                                        break;
                                    case "Confirmed":
                                        <i class="bi bi-check-circle me-1"></i>
                                        <span>Đã xác nhận</span>
                                        break;
                                    case "Completed":
                                        <i class="bi bi-book me-1"></i>
                                        <span>Hoàn tất</span>
                                        break;
                                    case "Cancelled":
                                    case "Canceled":
                                        <i class="bi bi-x-circle me-1"></i>
                                        <span>Đã hủy</span>
                                        break;
                                    default:
                                        <i class="bi bi-question-circle me-1"></i>
                                        <span>N/A</span>
                                        break;
                                }
                            </div>
                            <div class="payment-badge @(order.IsPaid ? "paid" : "unpaid")">
                                @if (order.IsPaid)
                                {
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    <span>Đã thanh toán</span>
                                }
                                else
                                {
                                    <i class="bi bi-clock me-1"></i>
                                    <span>Chưa thanh toán</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="order-actions">
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-eye me-1"></i>Xem chi tiết
                        </a>
                        @if (order.Status == "Pending" && !order.IsPaid)
                        {
                            <form asp-action="Delete" method="post" class="d-inline" 
                                  onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">
                                <input type="hidden" name="id" value="@order.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-x-circle me-1"></i>Hủy đơn
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .order-page {
        padding: 40px 0;
        min-height: 60vh;
    }

    .order-header {
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 2px solid #e9ecef;
    }

    .order-header h1 {
        font-size: 2rem;
        color: #333;
    }

    /* Order List */
    .order-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .order-item {
        background: white;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 20px;
    }

    .order-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 15px;
    }

    .order-info {
        flex: 1;
    }

    .order-code {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1976d2;
    }

    .order-date {
        font-size: 0.9rem;
        color: #6c757d;
        display: flex;
        align-items: center;
    }

    .order-products {
        margin-top: 10px;
    }

    .product-item {
        font-size: 0.9rem;
        color: #495057;
        margin-bottom: 5px;
    }

    .order-status-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end;
        min-width: 200px;
    }

    .order-amount {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .amount-label {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .amount-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #28a745;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        width: fit-content;
    }

    .status-badge.badge-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-badge.badge-confirmed {
        background: #d4edda;
        color: #155724;
    }

    .status-badge.badge-completed {
        background: #d1ecf1;
        color: #0c5460;
    }

    .status-badge.badge-cancelled,
    .status-badge.badge-canceled {
        background: #f8d7da;
        color: #721c24;
    }

    .payment-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
        width: fit-content;
    }

    .payment-badge.paid {
        background: #d4edda;
        color: #155724;
    }

    .payment-badge.unpaid {
        background: #fff3cd;
        color: #856404;
    }

    .order-actions {
        display: flex;
        gap: 10px;
        padding-top: 15px;
        border-top: 1px solid #f1f3f4;
    }

    /* Empty State */
    .empty-orders {
        text-align: center;
        padding: 80px 20px;
        background: #f8f9fa;
        border-radius: 16px;
        border: 2px dashed #dee2e6;
    }

    .empty-icon {
        font-size: 5rem;
        color: #adb5bd;
        margin-bottom: 20px;
    }

    .empty-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 10px;
    }

    .empty-text {
        font-size: 1rem;
        color: #6c757d;
        margin-bottom: 30px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .order-header h1 {
            font-size: 1.5rem;
        }

        .order-main {
            flex-direction: column;
        }

        .order-status-section {
            align-items: flex-start;
            width: 100%;
        }

        .order-actions {
            flex-direction: column;
        }

        .order-actions .btn {
            width: 100%;
        }
    }
</style>
