@model WebBanHang.Models.Order

<h2>Chi tiết đơn hàng #@Model.Id</h2>

<p><strong>Người đặt:</strong> @Model.FullName</p>
<p><strong>Email:</strong> @Model.User?.Email</p>
<p><strong>SĐT:</strong> @Model.Phone</p>
<p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>

<p>
    <strong>Trạng thái:</strong>
    <span class="badge bg-@(Model.Status switch {
        "Pending" => "warning text-dark",
        "Confirmed" => "success",
        "Completed" => "primary",
        "Canceled" => "danger",
        _ => "secondary"
    })">@Model.Status</span>
</p>

<hr />

<h5>Sản phẩm trong đơn</h5>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên sách</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>

<p class="fw-bold text-end">Tổng cộng: @Model.Total.ToString("N0") đ</p>

<hr />

<div class="d-flex justify-content-between align-items-center">
    <a asp-controller="Order"
       asp-action="Index"
       class="btn btn-outline-primary btn-sm">
        ← Quay lại danh sách
    </a>

    @if (Model.Status == "Confirmed" && !Model.IsPaid)
    {
        <a asp-controller="Checkout"
           asp-action="FakePay"
           asp-route-orderId="@Model.Id"
           class="btn btn-success btn-sm">
            💳 Thanh toán ngay
        </a>
    }
    else if (Model.IsPaid)
    {
        <a asp-controller="Order"
           asp-action="Download"
           asp-route-id="@Model.Id"
           class="btn btn-primary btn-sm">
            📚 Tải sách
        </a>
    }
</div>

@if (Model.Status == "Pending")
{
    <div class="alert alert-warning mt-3 py-2 px-3" style="max-width: 500px; font-size: 0.9rem;">
        ⏳ Đơn hàng của bạn đang chờ admin xác nhận.<br />
        Vui lòng quay lại sau khi được duyệt để thanh toán.
    </div>
}