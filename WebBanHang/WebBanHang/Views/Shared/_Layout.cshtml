@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WebBanHang.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ApplicationDbContext _db

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 3T-books</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <!-- 🧩 PDF.js CDN chính thức -->
    <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
   
    <!-- Top Bar - Đổi thành màu trắng -->
    <div class="top-bar bg-white text-dark py-1 border-bottom">
        <div class="container d-flex justify-content-between align-items-center small">
            <div>
                📞 Hotline: <a href="tel:0123456789" class="text-dark text-decoration-none">0123 456 789</a> | ✉️ Email: <a href="mailto:support@3tbooks.com" class="text-dark text-decoration-none">support@3tbooks.com</a>
            </div>
            <div>
                <a href="#" class="text-dark me-2">Facebook</a>
                <a href="#" class="text-dark me-2">Instagram</a>
                <a href="#" class="text-dark">YouTube</a>
            </div>
        </div>
    </div>

    <!-- Header full width -->
    <div class="header-section sticky-top">
        <div class="header-container">
                <!-- Logo -->
            <div class="header-logo">
                    <a class="navbar-brand fw-bold fs-4" href="/">📚 3T-Books</a>
                </div>
                
                <!-- Menu chính -->
            <nav class="header-nav">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link" href="/">Trang Chủ</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Product" asp-action="Index">Sản Phẩm</a>
                                </li>
                    @if (!(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index"))
                    {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" 
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Thể loại
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
                                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">Tất cả thể loại</a></li>
                                        @{
                                            var categories = await _db.Categories.OrderBy(c => c.Name).ToListAsync();
                                        }
                                @foreach (var category in categories)
                                        {
                                            <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a></li>
                                        }
                                    </ul>
                                </li>
                    }
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Library" asp-action="Index">Thư viện</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Order" asp-action="Index">Đơn hàng</a>
                        </li>
                    }
                            </ul>
                    </nav>
                
                <!-- Search Bar -->
            <div class="header-search">
                    <form asp-controller="Product" asp-action="Search" method="get" class="search-form">
                        <div class="search-container">
                            <input class="search-input" type="search" name="keyword" placeholder="Search..." aria-label="Search" />
                            <button class="search-btn" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
                
                <!-- User & Cart Icons -->
            <div class="header-icons">
                    <a href="@(SignInManager.IsSignedIn(User) ? "/Identity/Account/Profile" : "/Identity/Account/Login")" class="user-icon">
                        <i class="bi bi-person-circle"></i>
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="cart-icon position-relative">
                        <i class="bi bi-bag"></i>
                        <span class="cart-badge">0</span>
                    </a>
            </div>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.success('@TempData["Success"]', 'Thành công');
                }
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.error('@TempData["Error"]', 'Lỗi');
                }
            });
        </script>
    }
    @if (TempData["Info"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                if (typeof NotificationSystem !== 'undefined') {
                    NotificationSystem.info('@TempData["Info"]', 'Thông tin');
                }
            });
        </script>
    }

   <!-- Notification Container -->
    <div class="notification-container" id="notificationContainer"></div>

   <!-- Chat Widget for Users -->
    <div class="chat-widget" id="chatWidget" style="display: none;">
        <div class="chat-header">
            <div class="chat-header-info">
                <i class="bi bi-headset"></i>
                <span>Hỗ trợ trực tuyến</span>
            </div>
            <button class="chat-close-btn" id="chatCloseBtn">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <div class="chat-body" id="chatBody">
            <!-- Messages will be loaded here -->
        </div>
        
        <!-- Image Modal -->
        <div id="imageModal" class="chat-image-modal">
            <span class="chat-image-modal-close" id="imageModalClose">&times;</span>
            <img id="modalImage" src="" alt="Hình ảnh" />
        </div>
        <div class="chat-footer">
            <input type="file" id="chatImageInput" accept="image/*" style="display: none;" />
            <button id="chatImageBtn" title="Gửi hình ảnh">
                <i class="bi bi-image"></i>
            </button>
            <input type="text" id="chatInput" placeholder="Nhập tin nhắn..." />
            <button id="chatSendBtn">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>

   <!-- Floating Support Buttons -->
    <div class="floating-support-widget" id="floatingSupportWidget">
        <div class="support-buttons">
            <button class="support-btn" id="telegramBtn" title="Chat trên Telegram">
                <i class="bi bi-telegram"></i>
            </button>
            <button class="support-btn" id="zaloBtn" title="Chat trên Zalo">
                <i class="bi bi-chat-dots"></i>
            </button>
            <button class="support-btn" id="phoneBtn" title="Gọi điện thoại">
                <i class="bi bi-telephone-fill"></i>
            </button>
            <button class="support-btn chat-btn" id="chatWidgetBtn" title="Chat với admin">
                <i class="bi bi-chat-dots-fill"></i>
            </button>
            <button class="support-btn primary" id="mainSupportBtn" title="Nhắn tin hỗ trợ">
                <i class="bi bi-chat" id="mainSupportIcon"></i>
            </button>
        </div>
    </div>

   <main>
        <div class="container">
            @RenderBody()
        </div>
   </main>
  

    <!-- Footer -->
    <footer class="bg-light text-dark pt-5 border-top mt-5">
        <div class="container">
            <div class="row gy-4">
                <!-- Logo + Info -->
                <div class="col-lg-4 col-md-6">
                    <h4 class="fw-bold mb-3">
                        <i class="bi bi-book-half text-success me-2"></i>3T-Books
                    </h4>
                    <p class="small text-muted">
                        Mang đến cho bạn những trải nghiệm mua sắm trực tuyến tiện lợi, an toàn và nhanh chóng.
                    </p>
                    <p class="fw-bold mb-1"><i class="bi bi-telephone me-2 text-success"></i>Cần hỗ trợ? Gọi ngay </p>
                    <h5 class="text-success">+0123 456 789</h5>
                    <div class="mt-3">
                        <span class="small"><i class="bi bi-credit-card-2-front me-1"></i> Phương thức thanh toán</span><br />
                        <img src="https://i.ibb.co/0jqHpnp/payment.png" alt="Payment Methods" style="max-height:30px;">
                    </div>
                </div>

                <!-- Thông tin -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Thông tin</h6>
                    <ul class="list-unstyled small text-muted">
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Giới thiệu</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Câu hỏi thường gặp</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Hướng dẫn mua hàng</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Thanh toán an toàn</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Phương thức thanh toán</a></li>
                    </ul>
                </div>

                <!-- Dịch vụ khách hàng -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3"><i class="bi bi-headset me-2"></i>Dịch vụ khách hàng</h6>
                    <ul class="list-unstyled small text-muted">
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Điều khoản & điều kiện</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Hình thức thanh toán</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Cam kết hoàn tiền</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Chính sách đổi trả</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Giao hàng</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <!-- Tài khoản của tôi -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3"><i class="bi bi-person-circle me-2"></i>Tài khoản của tôi</h6>
                    <ul class="list-unstyled small text-muted">
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Sơ đồ website</a></li>
                        <li><a href="#" class="text-decoration-none text-dark"><i class="bi bi-chevron-right me-1"></i> Hệ thống cửa hàng</a></li>
