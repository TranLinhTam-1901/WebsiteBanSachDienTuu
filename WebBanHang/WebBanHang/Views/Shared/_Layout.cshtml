        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
        <script src="~/js/notification.js" asp-append-version="true"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Cập nhật số lượng giỏ hàng - Đơn giản: fetch từ server mỗi lần
        function updateCartCount() {
            fetch('/Cart/GetCount')
                .then(response => response.json())
                .then(data => {
                    updateCartBadge(data.count);
                })
                .catch(error => {
                    console.error('Error updating cart count:', error);
                });
        }

        function updateCartBadge(count) {
            const cartBadge = document.querySelector('.cart-badge');
            if (cartBadge) {
                cartBadge.textContent = count || 0;
                if (count > 0) {
                    cartBadge.style.display = 'flex';
                } else {
                    cartBadge.style.display = 'none';
                }
            }
        }

        // Fetch cart count khi trang load
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
        });

        // Expose function globally
        window.updateCartCount = updateCartCount;
        window.updateCartBadge = updateCartBadge;

        // Floating Support Widget Functionality
        function initSupportWidget() {
            console.log('Initializing support widget...');
            const mainSupportBtn = document.getElementById('mainSupportBtn');
            const supportButtons = document.querySelector('.support-buttons');
            const telegramBtn = document.getElementById('telegramBtn');
            const zaloBtn = document.getElementById('zaloBtn');
            const phoneBtn = document.getElementById('phoneBtn');

            console.log('Main button found:', !!mainSupportBtn);
            console.log('Support buttons found:', !!supportButtons);

            if (!mainSupportBtn || !supportButtons) {
                console.error('Support widget elements not found!');
                return;
            }

            // Toggle expand/collapse
            mainSupportBtn?.addEventListener('click', function(e) {
                e.stopPropagation();
                const isExpanded = supportButtons.classList.toggle('expanded');
                this.classList.toggle('expanded');
                
                // Đổi icon
                const icon = document.getElementById('mainSupportIcon');
                if (icon) {
                    if (isExpanded) {
                        icon.classList.remove('bi-chat');
                        icon.classList.add('bi-x-lg');
                    } else {
                        icon.classList.remove('bi-x-lg');
                        icon.classList.add('bi-chat');
                        
                        // Đóng chat widget khi đóng support widget
                        const chatWidget = document.getElementById('chatWidget');
                        if (chatWidget) {
                            chatWidget.style.display = 'none';
                        }
                    }
                }
                
                console.log('Support buttons toggled, expanded:', isExpanded);
            });

            // Telegram button
            telegramBtn?.addEventListener('click', function(e) {
                e.stopPropagation();
                console.log('Telegram button clicked');
                // Thay đổi link Telegram của bạn
                window.open('https://t.me/YOUR_TELEGRAM_USERNAME', '_blank');
            });

            // Zalo button
            zaloBtn?.addEventListener('click', function(e) {
                e.stopPropagation();
                console.log('Zalo button clicked');
                // Thay đổi link Zalo của bạn
                window.open('https://zalo.me/YOUR_PHONE_NUMBER', '_blank');
            });

            // Phone button
            phoneBtn?.addEventListener('click', function(e) {
                e.stopPropagation();
                // Thay đổi số điện thoại của bạn
                console.log('Phone button clicked');
                window.location.href = 'tel:+84123456789';
            });

            console.log('Support widget initialized successfully');
        }

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSupportWidget);
        } else {
            initSupportWidget();
        }

        // Chat Widget Functionality
        const chatWidgetBtn = document.getElementById('chatWidgetBtn');
        const chatWidget = document.getElementById('chatWidget');
        const chatCloseBtn = document.getElementById('chatCloseBtn');
        const chatSendBtn = document.getElementById('chatSendBtn');
        const chatInput = document.getElementById('chatInput');
        const chatBody = document.getElementById('chatBody');
        const chatImageBtn = document.getElementById('chatImageBtn');
        const chatImageInput = document.getElementById('chatImageInput');
        let connection = null;

        // Initialize SignalR Connection
        @if (User.Identity.IsAuthenticated)
        {
            var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            <text>
            const userId = '@userId';
            
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub")
                .build();

            // Start connection
            connection.start()
                .then(() => {
                    console.log('SignalR Connected');
                })
                .catch(err => console.error('SignalR Error:', err));

            // Listen for messages
            connection.on("ReceiveMessage", function (senderId, message, messageId, createdAt, imageUrl) {
                console.log('Received message:', message);
                addMessageToChat(senderId, message, createdAt, imageUrl);
            });
            </text>
        }

        // Add message to chat UI
        function addMessageToChat(senderId, message, createdAt, imageUrl = null) {
            const isMine = senderId === userId;
            const messageDiv = document.createElement('div');
            messageDiv.className = `chat-message ${isMine ? 'sent' : 'received'}`;
            
            const createdAtDate = createdAt ? new Date(createdAt) : new Date();
            const bubbleClass = isMine ? 'user-bubble' : 'admin-bubble';
            
            let content = '';
            if (imageUrl) {
                content = `<img src="${imageUrl}" class="chat-image" alt="Hình ảnh" />`;
            }
            if (message) {
                content += `<div class="message-bubble ${bubbleClass}">${message}</div>`;
            }
            
            messageDiv.innerHTML = `
                ${content}
                <small class="message-time">${createdAtDate.toLocaleTimeString()}</small>
            `;
            
            chatBody.appendChild(messageDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        // Load chat history
        async function loadChatHistory() {
            @if (User.Identity.IsAuthenticated)
            {
                <text>
                try {
                    const response = await fetch('/api/ChatApi/messages');
                    const data = await response.json();
                    
                    chatBody.innerHTML = '';
                    
                    if (data.messages && data.messages.length > 0) {
                        data.messages.forEach(msg => {
                            addMessageToChat(msg.senderId, msg.content, msg.createdAt, msg.imageUrl || null);
                        });
                    }
                } catch (error) {
                    console.error('Error loading chat history:', error);
                }
                </text>
            }
        }

        // Toggle chat widget
        chatWidgetBtn?.addEventListener('click', async function(e) {
            e.stopPropagation();
            
            if (chatWidget.style.display === 'none' || chatWidget.style.display === '') {
                chatWidget.style.display = 'block';
                await loadChatHistory();
            } else {
                chatWidget.style.display = 'none';
            }
        });

        chatCloseBtn?.addEventListener('click', function() {
            chatWidget.style.display = 'none';
        });

        // Send message
        async function sendMessage() {
            const message = chatInput.value.trim();
            if (!message) return;

            @if (User.Identity.IsAuthenticated)
            {
                <text>
                try {
                    // Send via SignalR
                    if (connection && connection.state === signalR.HubConnectionState.Connected) {
                        await connection.invoke("SendMessage", userId, message);
                    } else {
                        // Fallback: send via API
                        await fetch('/api/ChatApi/send', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ message: message })
                        });
                    }
                    
                    // Clear input - SignalR will handle displaying the message
                    chatInput.value = '';
                } catch (error) {
                    console.error('Error sending message:', error);
                }
                </text>
            }
            else
            {
                <text>
                alert('Vui lòng đăng nhập để chat');
                </text>
            }
        }

        chatSendBtn?.addEventListener('click', sendMessage);
        chatInput?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        // Upload image
        chatImageBtn?.addEventListener('click', function() {
            chatImageInput.click();
        });

        chatImageInput?.addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            // Validate file size (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                alert('File quá lớn! Vui lòng chọn file nhỏ hơn 5MB.');
                return;
            }

            // Validate file type
            if (!file.type.startsWith('image/')) {
                alert('Vui lòng chọn file hình ảnh!');
                return;
            }

            @if (User.Identity.IsAuthenticated)
            {
                <text>
                try {
                    // Upload image
                    const formData = new FormData();
                    formData.append('file', file);

                    const response = await fetch('/api/ChatApi/upload-image', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    
                    if (data.success) {
                        // Send image via SignalR
                        if (connection && connection.state === signalR.HubConnectionState.Connected) {
                            await connection.invoke("SendImage", userId, data.imageUrl);
                        }
                    } else {
                        alert('Không thể upload hình ảnh!');
                    }
                } catch (error) {
                    console.error('Error uploading image:', error);
                    alert('Không thể upload hình ảnh!');
                }
                </text>
            }
            else
            {
                <text>
                alert('Vui lòng đăng nhập để gửi hình ảnh');
                </text>
            }

            // Reset input
            chatImageInput.value = '';
        });

        // Image modal functionality
        const imageModal = document.getElementById('imageModal');
        const modalImage = document.getElementById('modalImage');
        const imageModalClose = document.getElementById('imageModalClose');

        // Open modal when clicking on image
        chatBody.addEventListener('click', function(e) {
            if (e.target.classList.contains('chat-image')) {
                modalImage.src = e.target.src;
                imageModal.style.display = 'flex';
            }
        });

        // Close modal
        imageModalClose.addEventListener('click', function() {
            imageModal.style.display = 'none';
        });

        // Close modal when clicking outside
        imageModal.addEventListener('click', function(e) {
            if (e.target === imageModal) {
                imageModal.style.display = 'none';
            }
        });

        // Dropdown Category Menu - Keep open on click
        const categoryDropdown = document.getElementById('categoryDropdown');
        const categoryDropdownMenu = categoryDropdown?.nextElementSibling;
        
        if (categoryDropdown) {
            let isOpen = sessionStorage.getItem('categoryDropdownOpen') === 'true';
            
            // Set initial state
            if (isOpen) {
                categoryDropdown.setAttribute('aria-expanded', 'true');
                categoryDropdown.classList.add('show');
                if (categoryDropdownMenu) {
                    categoryDropdownMenu.classList.add('show');
                }
            }
            
            // Toggle on click
            categoryDropdown.addEventListener('click', function(e) {
                e.preventDefault();
                isOpen = !isOpen;
                
                if (isOpen) {
                    categoryDropdown.setAttribute('aria-expanded', 'true');
                    categoryDropdown.classList.add('show');
                    if (categoryDropdownMenu) {
                        categoryDropdownMenu.classList.add('show');
                    }
                    sessionStorage.setItem('categoryDropdownOpen', 'true');
                } else {
                    categoryDropdown.setAttribute('aria-expanded', 'false');
                    categoryDropdown.classList.remove('show');
                    if (categoryDropdownMenu) {
                        categoryDropdownMenu.classList.remove('show');
                    }
                    sessionStorage.setItem('categoryDropdownOpen', 'false');
                }
            });
            
            // Close when clicking outside
            document.addEventListener('click', function(e) {
                if (!categoryDropdown.contains(e.target)) {
                    categoryDropdown.setAttribute('aria-expanded', 'false');
                    categoryDropdown.classList.remove('show');
                    if (categoryDropdownMenu) {
                        categoryDropdownMenu.classList.remove('show');
                    }
                    sessionStorage.setItem('categoryDropdownOpen', 'false');
                }
            });
        }
        </script>

        @RenderSection("Scripts", required: false)
</body>
</html>
